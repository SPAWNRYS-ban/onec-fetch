{
  // Порядок и названия модулей совместимы с реестром fastfetch.
  "logo": "auto",
  "timeout": 3000,
  "interval": 200,
  "modules": [
    "Title", "Separator", "OS", "Host", "Kernel", "Uptime", "Packages",
    "Shell", "Display", "DE", "WM", "WMTheme", "Theme", "Icons", "Font",
    "Cursor", "Terminal", "CPU", "GPU", "Memory", "Swap", "Disk", "LocalIp",
    "Locale", "Version", "Colors",
    {"type": "Custom", "key": "Проект", "text": "onec-fetch", "format": "{value} на языке 1С"},
  ],
}
