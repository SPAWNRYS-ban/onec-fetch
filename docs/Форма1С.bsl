// Модуль управляемой формы внешней обработки для 1С:Предприятия 8.3.
// Создайте реквизит формы Вывод (Строка, неограниченная длина),
// многострочное поле Вывод и команду Обновить с действием Обновить.

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Обновить(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
    // Контекст клиента: здесь собираются сведения о его компьютере.
    // В веб-клиенте часть сведений ограничена платформой.
    СИ = Новый СистемнаяИнформация;
    Строки = Новый Массив;
    Строки.Добавить("1С:Предприятие / onec-fetch");
    Строки.Добавить("---------------------------");
    Строки.Добавить("ОС: " + СИ.ВерсияОС);
    Строки.Добавить("Платформа: " + СИ.ВерсияПриложения);
    Строки.Добавить("Тип платформы: " + Строка(СИ.ТипПлатформы));
    Попытка
        Строки.Добавить("Процессор: " + Строка(СИ.Процессор));
    Исключение
        Строки.Добавить("Процессор: недоступен в этом клиенте");
    КонецПопытки;
    Попытка
        Строки.Добавить("Память: " + Формат(СИ.ОперативнаяПамять, "ЧГ=0") + " МБ всего");
    Исключение
        Строки.Добавить("Память: недоступна в этом клиенте");
    КонецПопытки;
    Строки.Добавить(ПолучитьСведенияБазы());
    Строки.Добавить("Время: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss"));
    Лого = Новый Массив;
    Лого.Добавить("                        ");
    Лого.Добавить("   111      CCCCCCCC    ");
    Лого.Добавить(" 11111    CCC     CCC   ");
    Лого.Добавить("   111   CCC            ");
    Лого.Добавить("   111   CCC            ");
    Лого.Добавить("   111   CCC            ");
    Лого.Добавить("   111    CCC     CCC   ");
    Лого.Добавить(" 1111111    CCCCCCCC    ");
    Вывод = "";
    Для Индекс = 0 По Строки.Количество() - 1 Цикл
        Слева = "";
        Если Индекс < Лого.Количество() Тогда Слева = Лого[Индекс]; КонецЕсли;
        Пока СтрДлина(Слева) < 24 Цикл Слева = Слева + " "; КонецЦикла;
        Вывод = Вывод + Слева + "  " + Строки[Индекс] + Символы.ПС;
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСведенияБазы()
    // Сервер нужен только для метаданных и имени пользователя базы.
    // Строку соединения и учетные данные не выводим.
    Возврат "Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия
        + Символы.ПС + "                          Пользователь базы: " + ИмяПользователя();
КонецФункции
