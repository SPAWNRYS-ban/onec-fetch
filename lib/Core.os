// Общая обработка, измерения и управление процессами на языке 1С.
Перем КешКоманд, Таймаут;

Функция Среда(Имя) Экспорт
    Значение = ПолучитьПеременнуюСреды(Имя);
    Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция Текст(Путь) Экспорт
    Попытка
        Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
        Результат = Чтение.Прочитать(); Чтение.Закрыть();
        Возврат ?(Результат = Неопределено, "", Результат);
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

Функция ЕстьФайл(Путь) Экспорт
    Возврат Новый Файл(Путь).Существует();
КонецФункции

Функция Файлы(Путь, Маска = "*") Экспорт
    Попытка Возврат НайтиФайлы(Путь, Маска); Исключение Возврат Новый Массив; КонецПопытки;
КонецФункции

Функция Поле(Текст, Ключ, Разделитель = ":") Экспорт
    Для Каждого Линия Из СтрРазделить(Текст, Символы.ПС) Цикл
        Позиция = Найти(Линия, Разделитель);
        Если Позиция > 0 И СокрЛП(Лев(Линия, Позиция - 1)) = Ключ Тогда
            Возврат СокрЛП(Сред(Линия, Позиция + 1));
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция БезКавычек(Текст) Экспорт
    Текст = СокрЛП(Текст);
    Если СтрДлина(Текст) >= 2 Тогда
        Знак = Лев(Текст, 1);
        Если (Знак = Символ(34) Или Знак = "'") И Прав(Текст, 1) = Знак Тогда
            Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
        КонецЕсли;
    КонецЕсли;
    Возврат Текст;
КонецФункции

Функция Префикс(Текст, Ключ) Экспорт
    Для Каждого Линия Из СтрРазделить(Текст, Символы.ПС) Цикл
        Линия = СокрЛП(Линия);
        Если Лев(Линия, СтрДлина(Ключ)) = Ключ Тогда Возврат СокрЛП(Сред(Линия, СтрДлина(Ключ) + 1)); КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция Слова(Текст) Экспорт
    Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Текст), Символы.Таб, " "), Символы.ВК, "");
    Пока Найти(Текст, "  ") > 0 Цикл Текст = СтрЗаменить(Текст, "  ", " "); КонецЦикла;
    Возврат СтрРазделить(Текст, " ", Ложь);
КонецФункции

Функция ЧислоБезопасно(Значение, ПоУмолчанию = 0) Экспорт
    Попытка Возврат Число(СтрЗаменить(СокрЛП(Строка(Значение)), ",", "."));
    Исключение Возврат ПоУмолчанию; КонецПопытки;
КонецФункции

Функция Значение(Объект, Ключ, ПоУмолчанию = "") Экспорт
    Попытка
        Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
            Результат = Объект.Получить(Ключ);
            Возврат ?(Результат = Неопределено, ПоУмолчанию, Результат);
        КонецЕсли;
        Результат = Неопределено;
        Если Объект.Свойство(Ключ, Результат) Тогда Возврат Результат; КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат ПоУмолчанию;
КонецФункции

Функция Блоки(Текст) Экспорт
    Текст = СтрЗаменить(Текст, Символы.ВК, "");
    Возврат СтрРазделить(СтрЗаменить(Текст, Символы.ПС + Символы.ПС, Символ(1)), Символ(1), Ложь);
КонецФункции

Функция JSONПоля(Данные)
    Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
        Результат = Новый Структура;
        Для Каждого Элемент Из Данные Цикл
            Имя = "";
            Для Индекс = 1 По СтрДлина(Элемент.Ключ) Цикл
                Знак = Сред(Элемент.Ключ, Индекс, 1);
                Если Найти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", Знак) = 0 Тогда Знак = "_"; КонецЕсли;
                Имя = Имя + Знак;
            КонецЦикла;
            Если Имя = "" Тогда Имя = "_"; КонецЕсли;
            Если Найти("0123456789", Лев(Имя, 1)) > 0 Тогда Имя = "_" + Имя; КонецЕсли;
            Результат.Вставить(Имя, JSONПоля(Элемент.Значение));
        КонецЦикла;
        Возврат Результат;
    ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Данные Цикл Результат.Добавить(JSONПоля(Элемент)); КонецЦикла;
        Возврат Результат;
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция JSON(Текст) Экспорт
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение, Истина); Чтение.Закрыть(); Возврат JSONПоля(Результат);
КонецФункции

Функция ВJSON(Объект) Экспорт
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Объект); Возврат Запись.Закрыть();
КонецФункции

Функция INI(Путь, Секция, Ключ) Экспорт
    ТекущаяСекция = "";
    Для Каждого Линия Из СтрРазделить(Текст(Путь), Символы.ПС) Цикл
        Линия = СокрЛП(Линия);
        Если Лев(Линия, 1) = "[" Тогда
            ТекущаяСекция = Сред(Линия, 2, СтрДлина(Линия) - 2);
        ИначеЕсли ТекущаяСекция = Секция Тогда
            // KDE записывает immutable/$e модификаторы после имени ключа.
            Позиция = Найти(Линия, "=");
            Если Позиция > 0 Тогда
                Имя = Лев(Линия, Позиция - 1);
                Если Найти(Имя, "[") > 0 Тогда Имя = Лев(Имя, Найти(Имя, "[") - 1); КонецЕсли;
                Если Имя = Ключ Тогда Возврат Сред(Линия, Позиция + 1); КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция ФорматЧисла(Значение, Знаков = 0) Экспорт
    Возврат Формат(Значение, "ЧГ=0; ЧН=0; ЧДЦ=" + Строка(Знаков));
КонецФункции

Функция GiB(Байты) Экспорт
    Возврат ФорматЧисла(Байты / 1073741824, 2) + " GiB";
КонецФункции

Функция Процент(Занято, Всего) Экспорт
    Возврат ?(Всего > 0, Мин(100, Макс(0, Занято / Макс(1, Всего) * 100)), 0);
КонецФункции

Функция Размеры(Занято, Всего) Экспорт
    Возврат GiB(Занято) + " / " + GiB(Всего) + " (" + ФорматЧисла(Процент(Занято, Всего)) + "%)";
КонецФункции

Функция Аргумент(Текст) Экспорт
    // В Unix OneScript 2.2 использует удвоение кавычек; Windows — правила .NET.
    Если Найти(НРег(Строка(Новый СистемнаяИнформация().ТипПлатформы)), "win") = 0 Тогда
        Возврат Символ(34) + СтрЗаменить(Текст, Символ(34), Символ(34) + Символ(34)) + Символ(34);
    КонецЕсли;
    Результат = Символ(34); Слеши = 0;
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Знак = Сред(Текст, Индекс, 1);
        Если Знак = "\" Тогда Слеши = Слеши + 1; Продолжить; КонецЕсли;
        Если Знак = Символ(34) Тогда Количество = Слеши * 2 + 1; Иначе Количество = Слеши; КонецЕсли;
        Для Номер = 1 По Количество Цикл Результат = Результат + "\"; КонецЦикла;
        Результат = Результат + Знак; Слеши = 0;
    КонецЦикла;
    Для Номер = 1 По Слеши * 2 Цикл Результат = Результат + "\"; КонецЦикла;
    Возврат Результат + Символ(34);
КонецФункции

Процедура Настроить(Миллисекунды) Экспорт
    Таймаут = Миллисекунды; КешКоманд = Новый Соответствие;
КонецПроцедуры

Функция Команда(Программа, Параметры = Неопределено, БезКеша = Ложь) Экспорт
    СтрокаКоманды = Аргумент(Программа);
    Если Параметры <> Неопределено Тогда
        Для Каждого Параметр Из Параметры Цикл СтрокаКоманды = СтрокаКоманды + " " + Аргумент(Строка(Параметр)); КонецЦикла;
    КонецЕсли;
    Если Не БезКеша И КешКоманд.Получить(СтрокаКоманды) <> Неопределено Тогда Возврат КешКоманд.Получить(СтрокаКоманды); КонецЕсли;
    Результат = Новый Структура("status,stdout,stderr,exitCode,source", "unavailable", "", "", -1, Программа);
    Попытка
        Окружение = Новый Соответствие; Окружение.Вставить("LC_ALL", "C");
        Запуск = СтрокаКоманды;
        Если Найти(НРег(Строка(Новый СистемнаяИнформация().ТипПлатформы)), "win") = 0 Тогда
            // Unix-парсер OneScript теряет пустые аргументы и не умеет quotes в EXE.
            // Фиксированный exec передаёт значения только через quoted env expansion.
            // Здесь нет eval и нет вставки обнаруженных строк в код shell.
            Окружение.Вставить("ONECFETCH_ARG0", Программа); Шаблон = "exec " + Символ(34) + "$ONECFETCH_ARG0" + Символ(34);
            Если Параметры <> Неопределено Тогда
                Индекс = 1;
                Для Каждого Параметр Из Параметры Цикл
                    Имя = "ONECFETCH_ARG" + Строка(Индекс); Окружение.Вставить(Имя, Строка(Параметр));
                    Шаблон = Шаблон + " " + Символ(34) + "$" + Имя + Символ(34); Индекс = Индекс + 1;
                КонецЦикла;
            КонецЕсли;
            Запуск = Аргумент("/bin/sh") + " -c " + Аргумент(Шаблон);
        КонецЕсли;
        Процесс = СоздатьПроцесс(Запуск, , Истина, Ложь, КодировкаТекста.UTF8, Окружение);
        Процесс.Запустить(); Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Пока Не Процесс.Завершен Или Процесс.ПотокВывода.ЕстьДанные Или Процесс.ПотокОшибок.ЕстьДанные Цикл
            Результат.stdout = Результат.stdout + Процесс.ПотокВывода.Прочитать();
            Результат.stderr = Результат.stderr + Процесс.ПотокОшибок.Прочитать();
            Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > Таймаут Тогда
                Процесс.Завершить(Истина); Результат.status = "timeout"; Прервать;
            КонецЕсли;
            Если СтрДлина(Результат.stdout) + СтрДлина(Результат.stderr) > 4194304 Тогда
                Процесс.Завершить(Истина); Результат.status = "error"; Результат.stderr = "Output limit exceeded"; Прервать;
            КонецЕсли;
            Приостановить(5);
        КонецЦикла;
        Если Результат.status = "unavailable" Тогда
            Результат.exitCode = Процесс.КодВозврата;
            Результат.status = ?(Результат.exitCode = 0, "ok", "error");
            Если Результат.exitCode = 127 Тогда Результат.status = "unavailable"; КонецЕсли;
            Если Найти(НРег(Результат.stderr), "permission denied") > 0
                Или Найти(НРег(Результат.stderr), "access denied") > 0 Тогда Результат.status = "permission_denied"; КонецЕсли;
        КонецЕсли;
    Исключение
        Результат.stderr = ОписаниеОшибки();
    КонецПопытки;
    Если Не БезКеша Тогда КешКоманд.Вставить(СтрокаКоманды, Результат); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Арги(Текст = "") Экспорт
    Возврат СтрРазделить(Текст, "|", Ложь);
КонецФункции

Функция ЗапросКоманды(Программа, Аргументы = "") Экспорт
    Возврат Команда(Программа, Арги(Аргументы));
КонецФункции

Функция Успех(Данные, Представление = "", Источник = "") Экспорт
    Возврат Новый Структура("status,data,display,source,error", "ok", Данные, Представление, Источник, "");
КонецФункции

Функция Нет(Причина, Источник = "", Статус = "unavailable") Экспорт
    Возврат Новый Структура("status,data,display,source,error", Статус, Неопределено, "", Источник, Причина);
КонецФункции

Функция ИзКоманды(Результат) Экспорт
    Если Результат.status = "ok" Тогда Возврат Успех(Новый Структура("output", СокрЛП(Результат.stdout)), СокрЛП(Результат.stdout), Результат.source); КонецЕсли;
    Возврат Нет(Результат.stderr, Результат.source, Результат.status);
КонецФункции

Функция СписокСтрок(Текст) Экспорт
    Результат = Новый Массив;
    Для Каждого Линия Из СтрРазделить(Текст, Символы.ПС) Цикл
        Линия = СокрЛП(Линия);
        Если Линия <> "" Тогда Результат.Добавить(Линия); КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция Время(Секунды) Экспорт
    Возврат ФорматЧисла(Цел(Секунды / 86400)) + " д " + ФорматЧисла(Цел(Секунды / 3600) % 24) + " ч " + ФорматЧисла(Цел(Секунды / 60) % 60) + " мин";
КонецФункции

КешКоманд = Новый Соответствие; Таймаут = 3000;
