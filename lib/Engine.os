// Реестр, конфигурация, обработка результатов и общие модули на языке 1С.
Перем Реестр, Настройки, Результаты, ЭтоWindows;

Функция Имена() Экспорт
    Возврат СтрРазделить("Battery|BIOS|Bluetooth|BluetoothRadio|Board|Bootmgr|Break|Brightness|Btrfs|Camera|Chassis|Codec|Command|Colors|CPU|CPUCache|CPUUsage|Cursor|Custom|DateTime|DE|Display|Disk|DiskIO|DNS|Editor|Font|Gamepad|GPU|Host|Icons|InitSystem|Kernel|Keyboard|LM|Loadavg|Locale|LocalIp|Logo|Media|Memory|Monitor|Mouse|NetIO|OpenCL|OpenGL|OS|Packages|PhysicalDisk|PhysicalMemory|Player|PowerAdapter|Processes|PublicIp|Separator|Shell|Sound|Swap|Terminal|TerminalFont|TerminalSize|TerminalTheme|Title|Top|Theme|TPM|Uptime|Users|Version|Vulkan|Wallpaper|Weather|WM|Wifi|WMTheme|Zpool", "|");
КонецФункции

Функция Обычные() Экспорт
    Возврат Core.Арги("Title|Separator|OS|Host|Kernel|Uptime|Packages|Shell|Display|DE|WM|WMTheme|Theme|Icons|Font|Cursor|Terminal|CPU|GPU|Memory|Swap|Disk|LocalIp|Locale|Version|Colors");
КонецФункции

Функция КаноническоеИмя(Имя) Экспорт
    Для Каждого Кандидат Из Имена() Цикл Если НРег(Кандидат) = НРег(Имя) Тогда Возврат Кандидат; КонецЕсли; КонецЦикла;
    ВызватьИсключение "Неизвестный модуль: " + Имя + ". Используйте --list-modules.";
КонецФункции

Функция Метка(Имя) Экспорт
    Ключи = Core.Арги("OS|Host|Kernel|Uptime|Packages|Shell|Display|DE|WM|WMTheme|Theme|Icons|Font|Cursor|Terminal|CPU|GPU|Memory|Swap|Disk|LocalIp|Locale|Version|CPUCache|CPUUsage|PhysicalDisk|PhysicalMemory|Battery|Sound|Processes|Users|Wallpaper|BIOS|Board|Chassis|Bootmgr|InitSystem|DNS|Wifi|NetIO|DiskIO|Brightness|Monitor|TerminalSize|TerminalFont|TerminalTheme|Loadavg|Editor|Weather|PublicIp|PowerAdapter|Top|Camera|Keyboard|Mouse|Gamepad|Bluetooth|BluetoothRadio|Player|Media|TPM|OpenGL|OpenCL|Vulkan|Codec|Btrfs|Zpool|Custom|Command|DateTime|Logo");
    Значения = Core.Арги("ОС|Компьютер|Ядро|Работает|Пакеты|Оболочка|Экран|Среда|Оконный менеджер|Тема окон|Тема|Значки|Шрифт|Курсор|Терминал|Процессор|Видеокарта|Память|Swap|Диск|Локальный IP|Локаль|Исполнитель|Кеш CPU|Загрузка CPU|Накопитель|Планки памяти|Батарея|Звук|Процессы|Пользователи|Обои|BIOS|Плата|Корпус|Загрузчик|Init|DNS|Wi-Fi|Сеть IO|Диск IO|Яркость|Монитор|Размер терминала|Шрифт терминала|Тема терминала|Нагрузка|Редактор|Погода|Внешний IP|Блок питания|Top|Камера|Клавиатура|Мышь|Геймпад|Bluetooth|Bluetooth адаптер|Проигрыватель|Медиа|TPM|OpenGL|OpenCL|Vulkan|Кодеки|Btrfs|Zpool|Текст|Команда|Дата|Логотип");
    Индекс = Ключи.Найти(Имя);
    Возврат ?(Индекс = Неопределено, Имя, Значения[?(Индекс = Неопределено, 0, Индекс)]);
КонецФункции

Функция ЧитатьКонфиг(Путь) Экспорт
    Если Не Core.ЕстьФайл(Путь) Тогда ВызватьИсключение "Конфигурация не найдена: " + Путь; КонецЕсли;
    Чистый = Core.НативныйМодуль("JSONC").Очистить(Core.Текст(Путь));
    Возврат Core.JSON(Чистый);
КонецФункции

Процедура Начать(Параметры) Экспорт
    Если ТипЗнч(Параметры.modules) <> Тип("Массив") Тогда ВызватьИсключение "modules должен быть массивом"; КонецЕсли;
    Если ТипЗнч(Параметры.allowNetwork) <> Тип("Булево") Тогда ВызватьИсключение "allowNetwork должен быть true/false"; КонецЕсли;
    Настройки = Параметры; Core.Настроить(Параметры.timeout);
    Результаты = Новый Соответствие;
    СИ = Новый СистемнаяИнформация; ЭтоWindows = Найти(НРег(Строка(СИ.ТипПлатформы)), "win") > 0;
    Если ЭтоWindows Тогда Windows.Начать(Параметры); Иначе Linux.Начать(Параметры); КонецЕсли;
    Динамика = Ложь;
    Для Каждого Модуль Из Параметры.modules Цикл
        Если ТипЗнч(Модуль) <> Тип("Строка") И ТипЗнч(Модуль) <> Тип("Структура") Тогда ВызватьИсключение "Модуль должен быть строкой или объектом с type"; КонецЕсли;
        Имя = ?(ТипЗнч(Модуль) = Тип("Строка"), Модуль, Core.Значение(Модуль, "type"));
        Имя = КаноническоеИмя(Имя);
        Если Core.Арги("CPUUsage|DiskIO|NetIO|Top").Найти(Имя) <> Неопределено Тогда Динамика = Истина; КонецЕсли;
        Если Имя = "Top" Тогда Параметры.Вставить("collectTop", Истина); КонецЕсли;
    КонецЦикла;
    Если Динамика И Не ЭтоWindows Тогда Linux.Измерить(Параметры.interval); КонецЕсли;
КонецПроцедуры

Функция СетевойМодуль(Имя, Опции)
    Если Не Настройки.allowNetwork Тогда Возврат Core.Нет("Требуется --allow-network", "HTTP", "disabled"); КонецЕсли;
    Если Имя = "PublicIp" Тогда Хост = "api.ipify.org"; Путь = "/?format=json";
    Иначе
        Хост = "wttr.in"; Место = Core.Значение(Опции, "location", Настройки.location);
        Путь = "/" + КодироватьСтроку(Место, СпособКодированияСтроки.КодировкаURL) + "?format=j1";
    КонецЕсли;
    HTTP = Новый HTTPСоединение(Хост, 443, , , , Макс(1, Цел(Настройки.timeout / 1000)), Новый ЗащищенноеСоединениеOpenSSL);
    Запрос = Новый HTTPЗапрос(Путь); Запрос.Заголовки.Вставить("User-Agent", "onec-fetch/2.0");
    Ответ = HTTP.Получить(Запрос);
    Если Ответ.КодСостояния <> 200 Тогда Возврат Core.Нет("HTTP " + Строка(Ответ.КодСостояния), Хост, "error"); КонецЕсли;
    Данные = Core.JSON(Ответ.ПолучитьТелоКакСтроку());
    Если Имя = "PublicIp" Тогда Вывод = Данные.ip;
    Иначе
        Условия = Данные.current_condition[0]; Вывод = Условия.temp_C + " °C, " + Условия.weatherDesc[0].value;
    КонецЕсли;
    Возврат Core.Успех(Данные, Вывод, Хост);
КонецФункции

Функция Получить(Имя, Опции = Неопределено) Экспорт
    Имя = КаноническоеИмя(Имя);
    Если Опции = Неопределено Тогда Опции = Новый Структура; КонецЕсли;
    Попытка
        Если Имя = "Title" Тогда
            СИ = Новый СистемнаяИнформация; Пользователь = Core.Среда("USER"); Если Пользователь = "" Тогда Пользователь = Core.Среда("USERNAME"); КонецЕсли;
            Если Пользователь = "" Тогда Пользователь = СИ.ПользовательОС; КонецЕсли;
            Р = Core.Успех(Новый Структура("user,hostname", Пользователь, СИ.ИмяКомпьютера), Пользователь + "@" + СИ.ИмяКомпьютера, "SystemInfo");
        ИначеЕсли Имя = "Separator" Тогда Р = Core.Успех(Новый Структура("text", "-----------------------------"), "-----------------------------", "1C renderer");
        ИначеЕсли Имя = "Break" Тогда Р = Core.Успех(Новый Структура("text", ""), "", "1C renderer");
        ИначеЕсли Имя = "Colors" Тогда Р = Core.Успех(Новый Структура("colors", 16), "", "ANSI palette");
        ИначеЕсли Имя = "Version" Тогда Р = Core.Успех(Новый Структура("name,version,runtime", "onec-fetch", "2.1.0", Новый СистемнаяИнформация().Версия), "OneScript " + Новый СистемнаяИнформация().Версия + " / onec-fetch 2.1.0", "build metadata");
        ИначеЕсли Имя = "DateTime" Тогда Р = Core.Успех(Новый Структура("local,utc", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"), Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss")), Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"), "OneScript DateTime");
        ИначеЕсли Имя = "Locale" Тогда
            Локаль = Core.Среда("LC_ALL"); Если Локаль = "" Тогда Локаль = Core.Среда("LC_CTYPE"); КонецЕсли;
            Если Локаль = "" Тогда Локаль = Core.Среда("LANG"); КонецЕсли;
            Если Локаль = "" Тогда Локаль = "C"; КонецЕсли;
            Р = Core.Успех(Новый Структура("name", Локаль), Локаль, "LC_ALL, LC_CTYPE, LANG");
        ИначеЕсли Имя = "Logo" Тогда Р = Core.Успех(Новый Структура("selection", Настройки.logo), Настройки.logo, "assets/logos.json");
        ИначеЕсли Имя = "Custom" Тогда Р = Core.Успех(Новый Структура("text", Core.Значение(Опции, "text", "")), Core.Значение(Опции, "text", ""), "configuration");
        ИначеЕсли Имя = "Command" Тогда
            Команда = Core.Значение(Опции, "command", Настройки.command);
            Если Команда = "" Тогда Р = Core.Нет("Команда не задана явно", "configuration", "disabled");
            Иначе
                Если ЭтоWindows Тогда Программа = "cmd.exe"; Арги = Core.Арги("/d|/s|/c");
                Иначе Программа = "/bin/sh"; Арги = Core.Арги("-c"); КонецЕсли;
                Арги.Добавить(Команда); Р = Core.ИзКоманды(Core.Команда(Программа, Арги, Истина));
            КонецЕсли;
        ИначеЕсли Имя = "PublicIp" Или Имя = "Weather" Тогда Р = СетевойМодуль(Имя, Опции);
        ИначеЕсли Имя = "Editor" И Не ЭтоWindows Тогда
            Редактор = Core.Среда("VISUAL"); Если Редактор = "" Тогда Редактор = Core.Среда("EDITOR"); КонецЕсли;
            Если Редактор = "" Тогда Р = Core.Нет("VISUAL/EDITOR не заданы", "environment");
            Иначе Р = Core.Успех(Новый Структура("command", Редактор), Редактор, "VISUAL/EDITOR"); КонецЕсли;
        ИначеЕсли ЭтоWindows Тогда Р = Windows.Собрать(Имя);
        Иначе
            СИ = Новый СистемнаяИнформация;
            Если Найти(НРег(СИ.ИмяЯдра), "linux") > 0 Тогда Р = Linux.Собрать(Имя);
            Иначе Р = Core.Нет("Этот провайдер пока реализован для Linux/Windows", "platform", "unsupported"); КонецЕсли;
        КонецЕсли;
    Исключение
        Причина = ОписаниеОшибки(); Статус = "error";
        Если Найти(НРег(Причина), "access denied") > 0 Или Найти(НРег(Причина), "permission denied") > 0 Или Найти(НРег(Причина), "отказано в доступе") > 0 Тогда Статус = "permission_denied";
        ИначеЕсли Найти(НРег(Причина), "timed out") > 0 Или Найти(НРег(Причина), "timeout") > 0 Тогда Статус = "timeout"; КонецЕсли;
        Р = Core.Нет(Причина, Имя, Статус);
    КонецПопытки;
    Шаблон = Core.Значение(Опции, "format");
    Если Шаблон <> "" И Р.status = "ok" Тогда
        Значение = Р.display;
        Если ТипЗнч(Значение) = Тип("Массив") Тогда Значение = СтрСоединить(Значение, "; "); КонецЕсли;
        Шаблон = СтрЗаменить(Шаблон, "{value}", Строка(Значение));
        Если ТипЗнч(Р.data) = Тип("Структура") Тогда
            Для Каждого Поле Из Р.data Цикл
                Если ТипЗнч(Поле.Значение) = Тип("Строка") Или ТипЗнч(Поле.Значение) = Тип("Число") Тогда Шаблон = СтрЗаменить(Шаблон, "{" + Поле.Ключ + "}", Строка(Поле.Значение)); КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Р.display = Шаблон;
    КонецЕсли;
    Р.Вставить("type", Имя); Р.Вставить("key", Core.Значение(Опции, "key", Метка(Имя)));
    Результаты.Вставить(Имя, Р); Возврат Р;
КонецФункции

Функция ВсеРезультаты() Экспорт
    Массив = Новый Массив;
    Для Каждого Запись Из Настройки.modules Цикл
        Если ТипЗнч(Запись) = Тип("Строка") Тогда Имя = Запись; Опции = Новый Структура;
        Иначе Имя = Core.Значение(Запись, "type"); Опции = Запись; КонецЕсли;
        Массив.Добавить(Получить(Имя, Опции));
    КонецЦикла;
    Возврат Массив;
КонецФункции

Функция ИзРезультатов(Имя) Экспорт
    Р = Результаты.Получить(Имя);
    Если Р = Неопределено Тогда Р = Core.Нет("Модуль не выбран", "configuration", "disabled"); КонецЕсли;
    Возврат Р;
КонецФункции

Функция СовместимыйJSON() Экспорт
    СИ = Новый СистемнаяИнформация; Заголовок = Получить("Title").data;
    Данные = Новый Структура("user,hostname,host,os,os_id,os_id_like,kernel,architecture,runtime,cpu,threads,gpu,memory,uptime,shell,desktop,session,terminal,note", Заголовок.user, Заголовок.hostname, "", СИ.ВерсияОС, "", "", СИ.ИмяЯдра, ?(СИ.Это64БитнаяОперационнаяСистема, "64 bit", "32 bit"), "OneScript " + СИ.Версия, "", СИ.КоличествоПроцессоров, "", "", "", Core.Среда("SHELL"), Core.Среда("XDG_CURRENT_DESKTOP"), Core.Среда("XDG_SESSION_TYPE"), "", "");
    Поля = Core.Арги("Host|host|OS|os|Kernel|kernel|CPU|cpu|Memory|memory|Uptime|uptime|GPU|gpu|Terminal|terminal");
    Для Индекс = 0 По Поля.Количество() - 1 Цикл
        Если Индекс % 2 <> 0 Тогда Продолжить; КонецЕсли;
        Р = ИзРезультатов(Поля[Индекс]);
        Если Р.status = "ok" Тогда
            Представление = Р.display;
            Если ТипЗнч(Представление) = Тип("Массив") Тогда Представление = СтрСоединить(Представление, "; "); КонецЕсли;
            Данные.Вставить(Поля[Индекс + 1], Представление);
        КонецЕсли;
    КонецЦикла;
    ОС = ИзРезультатов("OS");
    Если ОС.status = "ok" Тогда Данные.os_id = Core.Значение(ОС.data, "id"); Данные.os_id_like = Core.Значение(ОС.data, "idLike"); КонецЕсли;
    Если Данные.os_id = "" И Не ЭтоWindows Тогда
        ОСФайл = Core.Текст("/etc/os-release");
        Данные.os_id = Core.БезКавычек(Core.Поле(ОСФайл, "ID", "="));
        Данные.os_id_like = Core.БезКавычек(Core.Поле(ОСФайл, "ID_LIKE", "="));
    КонецЕсли;
    Возврат Данные;
КонецФункции
