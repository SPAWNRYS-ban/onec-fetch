// Linux-сборщики. Чтение и расчёты выполняются на языке 1С.
Перем Окружение, Параметры, Кеш, СнимокДо, СнимокПосле, Интервал;

Процедура Начать(Настройки) Экспорт
    Параметры = Настройки; Кеш = Новый Соответствие;
    Окружение = Core.Текст("/etc/os-release");
    Если Окружение = "" Тогда Окружение = Core.Текст("/usr/lib/os-release"); КонецЕсли;
КонецПроцедуры

Функция Список(Текст) 
    Возврат Core.Арги(Текст);
КонецФункции

Функция DMI(Имя)
    Значение = СокрЛП(Core.Текст("/sys/class/dmi/id/" + Имя));
    Если Список("to be filled by o.e.m.|default string|not specified|unknown|none|system product name|system version|system manufacturer").Найти(НРег(Значение)) <> Неопределено Тогда Возврат ""; КонецЕсли;
    Возврат Значение;
КонецФункции

Функция Конфиг(Файл, Секция, Ключ)
    Корень = Core.Среда("XDG_CONFIG_HOME");
    Если Корень = "" Тогда Корень = Core.Среда("HOME") + "/.config"; КонецЕсли;
    Результат = Core.INI(Корень + "/" + Файл, Секция, Ключ);
    Если Результат = "" Тогда Результат = Core.INI(Корень + "/kdedefaults/" + Файл, Секция, Ключ); КонецЕсли;
    Если Результат = "" Тогда Результат = Core.INI("/etc/xdg/" + Файл, Секция, Ключ); КонецЕсли;
    Возврат Результат;
КонецФункции

Функция СтрокаДанных(Данные, Источник)
    Если Данные = "" Тогда Возврат Core.Нет("Источник не содержит значения", Источник); КонецЕсли;
    Возврат Core.Успех(Новый Структура("value", Данные), Данные, Источник);
КонецФункции

Функция Версия(Программа)
    Р = Core.ЗапросКоманды(Программа, "--version");
    Если Р.status <> "ok" Тогда Возврат ""; КонецЕсли;
    Линии = Core.СписокСтрок(Р.stdout);
    Если Линии.Количество() = 0 Тогда Возврат ""; КонецЕсли;
    Возврат Линии[0];
КонецФункции

Функция ОС()
    Название = Core.БезКавычек(Core.Поле(Окружение, "PRETTY_NAME", "="));
    Архитектура = СокрЛП(Core.ЗапросКоманды("uname", "-m").stdout);
    Данные = Новый Структура("name,id,idLike,version,architecture", Название,
        Core.БезКавычек(Core.Поле(Окружение, "ID", "=")),
        Core.БезКавычек(Core.Поле(Окружение, "ID_LIKE", "=")),
        Core.БезКавычек(Core.Поле(Окружение, "VERSION_ID", "=")), Архитектура);
    Возврат Core.Успех(Данные, Название + " " + Архитектура, "os-release, uname");
КонецФункции

Функция Компьютер(Модуль)
    Если Модуль = "Host" Тогда
        Имя = DMI("product_name"); Производитель = DMI("sys_vendor"); Вер = DMI("product_version");
    ИначеЕсли Модуль = "Board" Тогда
        Имя = DMI("board_name"); Производитель = DMI("board_vendor"); Вер = DMI("board_version");
    ИначеЕсли Модуль = "BIOS" Тогда
        Имя = DMI("bios_vendor"); Производитель = Имя; Вер = DMI("bios_version") + " " + DMI("bios_date");
    Иначе
        Тип = Core.ЧислоБезопасно(DMI("chassis_type"));
        Имена = СтрРазделить("Unknown|Other|Unknown|Desktop|Low Profile Desktop|Pizza Box|Mini Tower|Tower|Portable|Laptop|Notebook|Hand Held|Docking Station|All In One|Sub Notebook|Space-saving|Lunch Box|Main Server|Expansion|SubChassis|Bus Expansion|Peripheral|Storage|Rack Mount|Sealed-case|Multi-system|Compact PCI|Advanced TCA|Blade|Blade Enclosure|Tablet|Convertible|Detachable|IoT Gateway|Embedded|Mini PC|Stick PC", "|");
        Имя = ?(Тип < Имена.Количество(), Имена[Мин(Тип, Имена.Количество() - 1)], "Unknown");
        Производитель = DMI("chassis_vendor"); Вер = DMI("chassis_version");
    КонецЕсли;
    Если Имя = "" Тогда Возврат Core.Нет("DMI недоступен", "sysfs DMI"); КонецЕсли;
    Возврат Core.Успех(Новый Структура("name,vendor,version", Имя, Производитель, Вер), СокрЛП(Имя + " " + Вер), "sysfs DMI");
КонецФункции

Функция Ядро()
    ВерсияЯдра = СокрЛП(Core.Текст("/proc/sys/kernel/osrelease"));
    Возврат Core.Успех(Новый Структура("name,release,architecture", "Linux", ВерсияЯдра, СокрЛП(Core.ЗапросКоманды("uname", "-m").stdout)), "Linux " + ВерсияЯдра, "/proc, uname");
КонецФункции

Функция Память(Модуль)
    Текст = Core.Текст("/proc/meminfo");
    Если Модуль = "Memory" Тогда
        Всего = Core.ЧислоБезопасно(Core.Слова(Core.Поле(Текст, "MemTotal"))[0]) * 1024;
        ПолеДоступно = Core.Поле(Текст, "MemAvailable");
        Доступно = Core.ЧислоБезопасно(СтрЗаменить(ПолеДоступно, "kB", "")) * 1024;
        Если Доступно <= 0 Или Доступно >= Всего Тогда
            Доступно = 0;
            Для Каждого Поле Из Список("MemFree|Buffers|Cached|SReclaimable|Shmem") Цикл
                Байты = Core.ЧислоБезопасно(СтрЗаменить(Core.Поле(Текст, Поле), "kB", "")) * 1024;
                Доступно = Доступно + ?(Поле = "Shmem", -Байты, Байты);
            КонецЦикла;
            Доступно = Мин(Всего, Макс(0, Доступно));
        КонецЕсли;
        Занято = Макс(0, Всего - Доступно);
        ARC = 0; ARCmin = 0;
        Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/spl/kstat/zfs/arcstats")) Цикл
            Части = Core.Слова(Линия); Если Части.Количество() < 3 Тогда Продолжить; КонецЕсли;
            Если Части[0] = "size" Тогда ARC = Core.ЧислоБезопасно(Части[2]);
            ИначеЕсли Части[0] = "c_min" Тогда ARCmin = Core.ЧислоБезопасно(Части[2]); КонецЕсли;
        КонецЦикла;
        ARC = Макс(0, ARC - ARCmin); Если ARC < Занято Тогда Занято = Занято - ARC; КонецЕсли;
        Возврат Core.Успех(Новый Структура("total,available,used,percentage", Всего, Доступно, Занято, Core.Процент(Занято, Всего)), Core.Размеры(Занято, Всего), "/proc/meminfo");
    КонецЕсли;
    Всего = Core.ЧислоБезопасно(Core.Слова(Core.Поле(Текст, "SwapTotal"))[0]) * 1024;
    Доступно = Core.ЧислоБезопасно(Core.Слова(Core.Поле(Текст, "SwapFree"))[0]) * 1024;
    Устройства = Новый Массив;
    Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/swaps")) Цикл
        Части = Core.Слова(Линия);
        Если Части.Количество() < 5 Или Части[0] = "Filename" Тогда Продолжить; КонецЕсли;
        Устройства.Добавить(Новый Структура("name,type,total,used,priority", Части[0], Части[1], Core.ЧислоБезопасно(Части[2]) * 1024, Core.ЧислоБезопасно(Части[3]) * 1024, Core.ЧислоБезопасно(Части[4])));
    КонецЦикла;
    Возврат Core.Успех(Новый Структура("total,used,percentage,devices", Всего, Всего - Доступно, Core.Процент(Всего - Доступно, Всего), Устройства), Core.Размеры(Всего - Доступно, Всего), "/proc/meminfo, /proc/swaps");
КонецФункции

Функция ЦП()
    Текст = Core.Текст("/proc/cpuinfo"); Имя = Core.Поле(Текст, "model name");
    Если Имя = "" Тогда Имя = Core.Поле(Текст, "Hardware"); КонецЕсли;
    Если Имя = "" Тогда Имя = "CPU"; КонецЕсли;
    Потоков = 0; Ядра = Новый Соответствие; Частота = 0;
    Для Каждого Блок Из Core.Блоки(Текст) Цикл
        Если Core.Поле(Блок, "processor") = "" Тогда Продолжить; КонецЕсли;
        Потоков = Потоков + 1;
        Ядро = Core.Поле(Блок, "core id");
        Если Ядро <> "" Тогда Ядра.Вставить(Core.Поле(Блок, "physical id") + ":" + Ядро, Истина); КонецЕсли;
        Частота = Макс(Частота, Core.ЧислоБезопасно(Core.Поле(Блок, "cpu MHz")) * 1000000);
    КонецЦикла;
    МаксЧастота = 0; БазЧастота = 0;
    Для Каждого Файл Из Core.Файлы("/sys/devices/system/cpu", "cpu*") Цикл
        МаксЧастота = Макс(МаксЧастота, Core.ЧислоБезопасно(Core.Текст(Файл.ПолноеИмя + "/cpufreq/cpuinfo_max_freq")) * 1000);
        БазЧастота = Макс(БазЧастота, Core.ЧислоБезопасно(Core.Текст(Файл.ПолноеИмя + "/cpufreq/base_frequency")) * 1000);
    КонецЦикла;
    Температура = Неопределено;
    Для Каждого Устройство Из Core.Файлы("/sys/class/hwmon", "hwmon*") Цикл
        Датчик = СокрЛП(Core.Текст(Устройство.ПолноеИмя + "/name"));
        Если Датчик <> "k10temp" И Датчик <> "coretemp" И Датчик <> "cpu_thermal" Тогда Продолжить; КонецЕсли;
        Температура = Core.ЧислоБезопасно(Core.Текст(Устройство.ПолноеИмя + "/temp1_input")) / 1000;
        Прервать;
    КонецЦикла;
    Представление = Имя + " (" + Core.ФорматЧисла(Потоков) + ")";
    Если МаксЧастота > 0 Тогда Представление = Представление + " @ " + Core.ФорматЧисла(МаксЧастота / 1000000000, 2) + " GHz"; КонецЕсли;
    Возврат Core.Успех(Новый Структура("name,vendor,logicalCores,physicalCores,currentFrequency,maxFrequency,baseFrequency,temperature", Имя, Core.Поле(Текст, "vendor_id"), Потоков, ?(Ядра.Количество() > 0, Ядра.Количество(), Неопределено), Частота, МаксЧастота, БазЧастота, Температура), Представление, "/proc/cpuinfo, CPU sysfs, hwmon");
КонецФункции

Функция КешЦП()
    Устройства = Новый Массив; Виденные = Новый Соответствие; Итоги = Новый Соответствие;
    Для Каждого ЦП Из Core.Файлы("/sys/devices/system/cpu", "cpu*") Цикл
        Для Каждого Элемент Из Core.Файлы(ЦП.ПолноеИмя + "/cache", "index*") Цикл
            Путь = Элемент.ПолноеИмя + "/";
            Уровень = СокрЛП(Core.Текст(Путь + "level")); ТипКеша = СокрЛП(Core.Текст(Путь + "type"));
            ОбщиеЯдра = СокрЛП(Core.Текст(Путь + "shared_cpu_list"));
            Ключ = Уровень + ":" + ТипКеша + ":" + ОбщиеЯдра;
            Если Виденные.Получить(Ключ) <> Неопределено Тогда Продолжить; КонецЕсли;
            Виденные.Вставить(Ключ, Истина);
            Размер = СокрЛП(Core.Текст(Путь + "size"));
            Байты = Core.ЧислоБезопасно(СтрЗаменить(СтрЗаменить(Размер, "K", ""), "M", "")) * ?(Прав(Размер, 1) = "M", 1048576, 1024);
            Устройства.Добавить(Новый Структура("level,type,bytes,sharedCpus", Core.ЧислоБезопасно(Уровень), ТипКеша, Байты, ОбщиеЯдра));
            КлючИтога = "L" + Уровень + " " + ТипКеша;
            Итоги.Вставить(КлючИтога, Core.Значение(Итоги, КлючИтога, 0) + Байты);
        КонецЦикла;
    КонецЦикла;
    Линии = Новый Массив;
    Для Каждого Итог Из Итоги Цикл Линии.Добавить(Итог.Ключ + ": " + Core.ФорматЧисла(Итог.Значение / 1024) + " KiB"); КонецЦикла;
    Если Устройства.Количество() = 0 Тогда Возврат Core.Нет("Кеши CPU не опубликованы в sysfs", "CPU sysfs"); КонецЕсли;
    Возврат Core.Успех(Устройства, Линии, "CPU sysfs, deduplicated shared_cpu_list");
КонецФункции

Функция Пакеты()
    Счетчики = Новый Соответствие;
    КаталогPacman = Core.Файлы("/var/lib/pacman/local"); Количество = 0;
    Для Каждого Файл Из КаталогPacman Цикл Если Файл.ЭтоКаталог() Тогда Количество = Количество + 1; КонецЕсли; КонецЦикла;
    Если Количество > 0 Тогда Счетчики.Вставить("pacman", Количество); КонецЕсли;
    Если Core.ЕстьФайл("/var/lib/dpkg/status") Тогда
        Количество = 0;
        Для Каждого Блок Из Core.Блоки(Core.Текст("/var/lib/dpkg/status")) Цикл
            Если Core.Поле(Блок, "Status") = "install ok installed" Тогда Количество = Количество + 1; КонецЕсли;
        КонецЦикла;
        Если Количество > 0 Тогда Счетчики.Вставить("dpkg", Количество); КонецЕсли;
    КонецЕсли;
    Если Core.ЕстьФайл("/lib/apk/db/installed") Тогда
        Количество = 0;
        Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/lib/apk/db/installed")) Цикл
            Если Лев(Линия, 2) = "P:" Тогда Количество = Количество + 1; КонецЕсли;
        КонецЦикла;
        Счетчики.Вставить("apk", Количество);
    КонецЕсли;
    Для Каждого Менеджер Из Список("rpm|xbps-query|nix-env|flatpak|snap") Цикл
        Если Менеджер = "rpm" Тогда Арг = "-qa";
        ИначеЕсли Менеджер = "xbps-query" Тогда Арг = "-l";
        ИначеЕсли Менеджер = "nix-env" Тогда Арг = "--query|--out-path";
        ИначеЕсли Менеджер = "flatpak" Тогда Арг = "list|--columns=application,branch,arch,installation";
        Иначе Арг = "list"; КонецЕсли;
        Р = Core.ЗапросКоманды(Менеджер, Арг);
        Если Р.status = "ok" Тогда
            Количество = Core.СписокСтрок(Р.stdout).Количество();
            Если Менеджер = "snap" Тогда Количество = Макс(0, Количество - 1); КонецЕсли;
            Если Количество > 0 Тогда Счетчики.Вставить(Менеджер, Количество); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Всего = 0; Вывод = "";
    Для Каждого Элемент Из Счетчики Цикл
        Всего = Всего + Элемент.Значение;
        Вывод = Вывод + ?(Вывод = "", "", ", ") + Core.ФорматЧисла(Элемент.Значение) + " (" + Элемент.Ключ + ")";
    КонецЦикла;
    Если Счетчики.Количество() = 0 Тогда Возврат Core.Нет("Поддерживаемые базы пакетов не найдены", "package databases"); КонецЕсли;
    Возврат Core.Успех(Новый Структура("total,managers", Всего, Счетчики), Вывод, "package databases");
КонецФункции

Функция Диски(Модуль)
    Если Модуль = "PhysicalDisk" Тогда
        Р = Core.ЗапросКоманды("lsblk", "-J|-b|-d|-o|NAME,MODEL,VENDOR,SIZE,ROTA,TRAN,TYPE");
        Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
        Данные = Core.JSON(Р.stdout).blockdevices; Линии = Новый Массив; Устройства = Новый Массив;
        Для Каждого Диск Из Данные Цикл
            Если Диск.type <> "disk" Тогда Продолжить; КонецЕсли;
            Устройства.Добавить(Диск); Линии.Добавить(Диск.name + ": " + СокрЛП(Core.Значение(Диск, "model")) + " " + Core.GiB(Core.ЧислоБезопасно(Диск.size)));
        КонецЦикла;
        Возврат Core.Успех(Устройства, Линии, "lsblk JSON");
    КонецЕсли;
    Р = Core.ЗапросКоманды("df", "-l|-B1|--output=source,fstype,size,used,avail,target");
    Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
    Данные = Новый Массив; Линии = Новый Массив; Виденные = Новый Соответствие;
    Для Каждого Линия Из Core.СписокСтрок(Р.stdout) Цикл
        Части = Core.Слова(Линия);
        Если Части.Количество() < 6 Или Лев(Части[0], 1) <> "/" Тогда Продолжить; КонецЕсли;
        Если Лев(Части[0], 9) = "/dev/loop" Тогда Продолжить; КонецЕсли;
        Если Виденные.Получить(Части[0]) <> Неопределено Тогда Продолжить; КонецЕсли;
        Виденные.Вставить(Части[0], Истина);
        Монтирование = Части[5];
        Для Индекс = 6 По Части.Количество() - 1 Цикл Монтирование = Монтирование + " " + Части[Индекс]; КонецЦикла;
        Всего = Core.ЧислоБезопасно(Части[2]); Занято = Core.ЧислоБезопасно(Части[3]);
        Данные.Добавить(Новый Структура("source,filesystem,total,used,available,percentage,mountpoint", Части[0], Части[1], Всего, Занято, Core.ЧислоБезопасно(Части[4]), Core.Процент(Занято, Всего), Монтирование));
        Линии.Добавить(Монтирование + ": " + Core.Размеры(Занято, Всего) + " — " + Части[1]);
    КонецЦикла;
    Возврат Core.Успех(Данные, Линии, "df -B1, used/total");
КонецФункции

Функция Видеокарты()
    Р = Core.ЗапросКоманды("lspci", "-vmm");
    Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
    Карты = Новый Массив; Линии = Новый Массив;
    NVIDIA = Core.ЗапросКоманды("nvidia-smi", "--query-gpu=pci.bus_id,name,memory.total,memory.used,temperature.gpu,utilization.gpu,clocks.max.graphics|--format=csv,noheader,nounits");
    Для Каждого Блок Из Core.Блоки(Р.stdout) Цикл
        Класс = НРег(Core.Поле(Блок, "Class"));
        Если Найти(Класс, "vga") = 0 И Найти(Класс, "3d controller") = 0 И Найти(Класс, "display controller") = 0 Тогда Продолжить; КонецЕсли;
        Производитель = Core.Поле(Блок, "Vendor"); Имя = Core.Поле(Блок, "Device"); Slot = Core.Поле(Блок, "Slot");
        ТипКарты = "Unknown";
        Данные = Новый Структура("name,vendor,pciSlot,type,driver,memoryTotal,memoryUsed,temperature,usage,maxFrequency", Имя, Производитель, Slot, ТипКарты, "", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);
        Для Каждого Папка Из Core.Файлы("/sys/bus/pci/devices", "*" + Slot) Цикл
            Уведомление = Core.Текст(Папка.ПолноеИмя + "/uevent"); Данные.driver = Core.Поле(Уведомление, "DRIVER", "=");
        КонецЦикла;
        Если Найти(НРег(Производитель), "nvidia") > 0 И NVIDIA.status = "ok" Тогда
            Для Каждого Запись Из Core.СписокСтрок(NVIDIA.stdout) Цикл
                Части = СтрРазделить(Запись, ",");
                Если Части.Количество() < 7 Тогда Продолжить; КонецЕсли;
                Если Прав(НРег(СокрЛП(Части[0])), СтрДлина(Slot)) <> НРег(Slot) Тогда Продолжить; КонецЕсли;
                Данные.name = СокрЛП(Части[1]); Данные.type = "Discrete";
                Данные.memoryTotal = Core.ЧислоБезопасно(Части[2], Неопределено); Данные.memoryUsed = Core.ЧислоБезопасно(Части[3], Неопределено);
                Если Данные.memoryTotal <> Неопределено Тогда Данные.memoryTotal = Данные.memoryTotal * 1048576; КонецЕсли;
                Если Данные.memoryUsed <> Неопределено Тогда Данные.memoryUsed = Данные.memoryUsed * 1048576; КонецЕсли;
                Данные.temperature = Core.ЧислоБезопасно(Части[4], Неопределено); Данные.usage = Core.ЧислоБезопасно(Части[5], Неопределено);
                Данные.maxFrequency = Core.ЧислоБезопасно(Части[6], Неопределено);
                Если Данные.maxFrequency <> Неопределено Тогда Данные.maxFrequency = Данные.maxFrequency * 1000000; КонецЕсли; Прервать;
            КонецЦикла;
        КонецЕсли;
        Карты.Добавить(Данные); Линии.Добавить(Данные.name + " [" + Данные.type + "]");
    КонецЦикла;
    Если Карты.Количество() = 0 Тогда Возврат Core.Успех(Карты, "", "lspci: no graphics devices"); КонецЕсли;
    Возврат Core.Успех(Карты, Линии, "lspci, PCI sysfs, optional nvidia-smi");
КонецФункции

Функция EDID(Выход)
    Для Каждого Папка Из Core.Файлы("/sys/class/drm", "card*-" + Выход) Цикл
        Р = Core.ЗапросКоманды("od", "-An|-v|-tu1|" + Папка.ПолноеИмя + "/edid");
        Если Р.status <> "ok" Тогда Продолжить; КонецЕсли;
        Байты = Core.Слова(СтрЗаменить(Р.stdout, Символы.ПС, " "));
        Если Байты.Количество() < 128 Тогда Продолжить; КонецЕсли;
        Для Смещение = 54 По 108 Цикл
            Если (Смещение - 54) % 18 <> 0 Тогда Продолжить; КонецЕсли;
            Если Байты[Смещение] = "0" И Байты[Смещение + 1] = "0" И Байты[Смещение + 3] = "252" Тогда
                Имя = "";
                Для Индекс = Смещение + 5 По Смещение + 17 Цикл
                    Код = Core.ЧислоБезопасно(Байты[Индекс]); Если Код = 10 Или Код = 0 Тогда Прервать; КонецЕсли;
                    Имя = Имя + Символ(Код);
                КонецЦикла;
                Возврат СокрЛП(Имя);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Выход;
КонецФункции

Функция Экраны(Модуль)
    Если Кеш.Получить("screens") = Неопределено Тогда
        Р = Core.ЗапросКоманды("kscreen-doctor", "-j"); Данные = Новый Массив;
        Если Р.status = "ok" Тогда
            Для Каждого Экран Из Core.JSON(Р.stdout).outputs Цикл
                Если Не Экран.connected Или Не Экран.enabled Тогда Продолжить; КонецЕсли;
                Режим = Неопределено;
                Для Каждого Кандидат Из Экран.modes Цикл Если Кандидат.id = Экран.currentModeId Тогда Режим = Кандидат; Прервать; КонецЕсли; КонецЦикла;
                Если Режим = Неопределено Тогда Продолжить; КонецЕсли;
                Размер = Core.Значение(Экран, "sizeMM", Новый Структура("width,height", 0, 0));
                Диагональ = Sqrt(Core.Значение(Размер, "width", 0) * Core.Значение(Размер, "width", 0) + Core.Значение(Размер, "height", 0) * Core.Значение(Размер, "height", 0)) / 25.4;
                Имя = EDID(Экран.name);
                ТипЭкрана = ?(Лев(Экран.name, 4) = "eDP-" Или Лев(Экран.name, 5) = "LVDS-", "Internal", "External");
                Данные.Добавить(Новый Структура("name,connector,width,height,refreshRate,scale,diagonal,type,hdr,rotation,physicalSize,preferredModes", Имя, Экран.name, Режим.size.width, Режим.size.height, Режим.refreshRate, Экран.scale, Диагональ, ТипЭкрана, Core.Значение(Экран, "hdr", Неопределено), Экран.rotation, Размер, Core.Значение(Экран, "preferredModes", Новый Массив)));
            КонецЦикла;
            Источник = "KScreen JSON, EDID";
        Иначе
            Р = Core.ЗапросКоманды("wlr-randr", "--json");
            Если Р.status = "ok" Тогда
                Для Каждого Экран Из Core.JSON(Р.stdout) Цикл
                    Для Каждого Режим Из Экран.modes Цикл
                        Если Core.Значение(Режим, "current", Ложь) Тогда
                            Данные.Добавить(Новый Структура("name,width,height,refreshRate,scale", Экран.name, Режим.width, Режим.height, Режим.refresh / 1000, Core.Значение(Экран, "scale", 1)));
                        КонецЕсли;
                    КонецЦикла;
                КонецЦикла;
                Источник = "wlr-randr JSON";
            Иначе
                Р = Core.ЗапросКоманды("xrandr", "--current"); Имя = "";
                Если Р.status = "ok" Тогда
                    Для Каждого Линия Из Core.СписокСтрок(Р.stdout) Цикл
                        Части = Core.Слова(Линия);
                        Если Части.Количество() > 1 И Части[1] = "connected" Тогда Имя = Части[0];
                        ИначеЕсли Имя <> "" И Найти(Линия, "*") > 0 Тогда
                            Разрешение = СтрРазделить(Части[0], "x");
                            Если Разрешение.Количество() = 2 Тогда
                                Частота = 0;
                                Для Каждого Часть Из Части Цикл Если Найти(Часть, "*") > 0 Тогда Частота = Core.ЧислоБезопасно(СтрЗаменить(СтрЗаменить(Часть, "*", ""), "+", "")); КонецЕсли; КонецЦикла;
                                Данные.Добавить(Новый Структура("name,width,height,refreshRate,scale", EDID(Имя), Core.ЧислоБезопасно(Разрешение[0]), Core.ЧислоБезопасно(Разрешение[1]), Частота, 1));
                            КонецЕсли;
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;
                Источник = "xrandr";
            КонецЕсли;
        КонецЕсли;
        Если Данные.Количество() = 0 Тогда Кеш.Вставить("screens", Core.Нет("Нет доступного display API для активного сеанса", Источник));
        Иначе Кеш.Вставить("screens", Core.Успех(Данные, "", Источник)); КонецЕсли;
    КонецЕсли;
    Результат = Кеш.Получить("screens");
    Если Результат.status <> "ok" Тогда Возврат Результат; КонецЕсли;
    Линии = Новый Массив;
    Для Каждого Экран Из Результат.data Цикл
        Вывод = Экран.name + ": " + Core.ФорматЧисла(Экран.width) + "x" + Core.ФорматЧисла(Экран.height);
        Если Core.Значение(Экран, "diagonal", 0) > 0 Тогда Вывод = Вывод + " (" + Core.ФорматЧисла(Экран.diagonal) + Символ(34) + ")"; КонецЕсли;
        Вывод = Вывод + ", " + Core.ФорматЧисла(Экран.refreshRate, 2) + " Hz";
        Если Модуль = "Monitor" Тогда Вывод = Вывод + ", scale " + Core.ФорматЧисла(Экран.scale, 2); КонецЕсли;
        Линии.Добавить(Вывод);
    КонецЦикла;
    Возврат Core.Успех(Результат.data, Линии, Результат.source);
КонецФункции

Функция ЦепочкаПроцессов()
    Если Кеш.Получить("parents") <> Неопределено Тогда Возврат Кеш.Получить("parents"); КонецЕсли;
    Цепочка = Новый Массив; PID = ТекущийПроцесс().Идентификатор; Виденные = Новый Соответствие;
    Пока PID > 1 И Цепочка.Количество() < 40 Цикл
        Если Виденные.Получить(PID) <> Неопределено Тогда Прервать; КонецЕсли;
        Виденные.Вставить(PID, Истина);
        Статус = Core.Текст("/proc/" + Core.ФорматЧисла(PID) + "/status");
        Если Статус = "" Тогда Прервать; КонецЕсли;
        Цепочка.Добавить(Новый Структура("pid,name", PID, Core.Поле(Статус, "Name")));
        PID = Core.ЧислоБезопасно(Core.Поле(Статус, "PPid"));
    КонецЦикла;
    Кеш.Вставить("parents", Цепочка); Возврат Цепочка;
КонецФункции

Функция ТерминалОболочка(Модуль)
    Если Модуль = "Shell" Тогда Имена = Список("bash|zsh|fish|dash|sh|nu|pwsh|ksh|tcsh|csh");
    Иначе Имена = Список("konsole|kitty|alacritty|gnome-terminal-|gnome-terminal|wezterm-gui|xfce4-terminal|foot|xterm|rxvt|tmux|screen|codex"); КонецЕсли;
    Для Каждого Процесс Из ЦепочкаПроцессов() Цикл
        Если Имена.Найти(Процесс.name) = Неопределено Тогда Продолжить; КонецЕсли;
        Имя = Процесс.name;
        Если Имя = "gnome-terminal-" Тогда Имя = "gnome-terminal"; КонецЕсли;
        Вер = ?(Имя = "codex", "", Версия(Имя));
        Если Имя = "bash" И Найти(Вер, "version ") > 0 Тогда
            Вер = Сред(Вер, Найти(Вер, "version ") + 8);
            Если Найти(Вер, "(") > 0 Тогда Вер = Лев(Вер, Найти(Вер, "(") - 1); КонецЕсли;
            Вер = "bash " + Вер;
        КонецЕсли;
        Данные = Новый Структура("name,version,pid,term", Имя, Вер, Процесс.pid, Core.Среда("TERM"));
        Возврат Core.Успех(Данные, ?(Вер = "", Имя, Вер), "/proc parent process tree");
    КонецЦикла;
    Если Модуль = "Shell" Тогда
        Имя = Core.Среда("SHELL");
        Если Имя <> "" Тогда Возврат Core.Успех(Новый Структура("name,version,fallback", Имя, Версия(Имя), Истина), Версия(Имя), "$SHELL fallback"); КонецЕсли;
    КонецЕсли;
    Возврат Core.Нет("Приложение терминала не определяется в этом контексте", "/proc parent process tree");
КонецФункции

Функция Оформление(Модуль)
    Если Модуль = "DE" Тогда
        Среда = Core.Среда("XDG_CURRENT_DESKTOP");
        Если Найти(ВРег(Среда), "KDE") > 0 Тогда Возврат СтрокаДанных(СтрЗаменить(Версия("plasmashell"), "plasmashell", "KDE Plasma"), "plasmashell --version"); КонецЕсли;
        Если Найти(ВРег(Среда), "GNOME") > 0 Тогда Возврат СтрокаДанных(Версия("gnome-shell"), "gnome-shell --version"); КонецЕсли;
        Если Найти(ВРег(Среда), "XFCE") > 0 Тогда Возврат СтрокаДанных(Версия("xfce4-session"), "xfce4-session --version"); КонецЕсли;
        Возврат СтрокаДанных(Среда, "XDG_CURRENT_DESKTOP");
    ИначеЕсли Модуль = "WM" Тогда
        Процессы = Core.СписокСтрок(Core.ЗапросКоманды("ps", "-eo|comm=").stdout);
        Для Каждого WM Из Список("kwin_wayland|kwin_x11|gnome-shell|sway|Hyprland|i3|xfwm4|mutter|openbox|weston|labwc|niri") Цикл
            Если Процессы.Найти(WM) = Неопределено Тогда Продолжить; КонецЕсли;
            Вер = Версия(WM);
            Возврат Core.Успех(Новый Структура("name,version,protocol", WM, Вер, Core.Среда("XDG_SESSION_TYPE")), WM + " (" + Core.Среда("XDG_SESSION_TYPE") + ")", "processes, version");
        КонецЦикла;
        Возврат Core.Нет("WM не обнаружен в активном сеансе", "processes");
    ИначеЕсли Модуль = "WMTheme" Тогда
        Возврат СтрокаДанных(Конфиг("kwinrc", "org.kde.kdecoration2", "theme"), "KWin config");
    ИначеЕсли Модуль = "Icons" Тогда
        KDE = Конфиг("kdeglobals", "Icons", "Theme"); GTK = Конфиг("gtk-3.0/settings.ini", "Settings", "gtk-icon-theme-name");
        Если GTK = "" Тогда GTK = Core.БезКавычек(СокрЛП(Core.ЗапросКоманды("gsettings", "get|org.gnome.desktop.interface|icon-theme").stdout)); КонецЕсли;
        Возврат СтрокаДанных(СокрЛП(?(KDE = "", "", KDE + " [Qt]") + ?(GTK = "", "", ?(KDE = "", "", ", ") + GTK + " [GTK]")), "KDE/GTK settings");
    ИначеЕсли Модуль = "Theme" Тогда
        KDE = Конфиг("kdeglobals", "General", "ColorScheme"); GTK = Конфиг("gtk-3.0/settings.ini", "Settings", "gtk-theme-name");
        Если GTK = "" Тогда GTK = Core.БезКавычек(СокрЛП(Core.ЗапросКоманды("gsettings", "get|org.gnome.desktop.interface|gtk-theme").stdout)); КонецЕсли;
        Возврат СтрокаДанных(СокрЛП(?(KDE = "", "", KDE + " [Qt]") + ?(GTK = "", "", ?(KDE = "", "", ", ") + GTK + " [GTK]")), "KDE/GTK settings");
    ИначеЕсли Модуль = "Font" Тогда
        KDE = Конфиг("kdeglobals", "General", "font"); GTK = Конфиг("gtk-3.0/settings.ini", "Settings", "gtk-font-name");
        Если GTK = "" Тогда GTK = Core.БезКавычек(СокрЛП(Core.ЗапросКоманды("gsettings", "get|org.gnome.desktop.interface|font-name").stdout)); КонецЕсли;
        Возврат СтрокаДанных(СокрЛП(?(KDE = "", "", KDE + " [Qt]") + ?(GTK = "", "", ?(KDE = "", "", ", ") + GTK + " [GTK]")), "KDE/GTK settings");
    ИначеЕсли Модуль = "Cursor" Тогда
        Тема = Конфиг("kcminputrc", "Mouse", "cursorTheme"); Размер = Конфиг("kcminputrc", "Mouse", "cursorSize");
        Если Тема = "" Тогда Тема = Core.БезКавычек(СокрЛП(Core.ЗапросКоманды("gsettings", "get|org.gnome.desktop.interface|cursor-theme").stdout)); КонецЕсли;
        Если Размер = "" Тогда Размер = СокрЛП(Core.ЗапросКоманды("gsettings", "get|org.gnome.desktop.interface|cursor-size").stdout); КонецЕсли;
        Возврат Core.Успех(Новый Структура("theme,size", Тема, Core.ЧислоБезопасно(Размер, Неопределено)), Тема + ?(Размер = "", "", " (" + Размер + "px)"), "cursor settings");
    ИначеЕсли Модуль = "Wallpaper" Тогда
        Пути = Новый Массив;
        Для Каждого Линия Из Core.СписокСтрок(Core.Текст(Core.Среда("HOME") + "/.config/plasma-org.kde.plasma.desktop-appletsrc")) Цикл
            Если Лев(Линия, 6) = "Image=" Тогда Пути.Добавить(Сред(Линия, 7)); КонецЕсли;
        КонецЦикла;
        Если Пути.Количество() = 0 Тогда
            Значение = Core.БезКавычек(СокрЛП(Core.ЗапросКоманды("gsettings", "get|org.gnome.desktop.background|picture-uri").stdout));
            Если Значение <> "" Тогда Пути.Добавить(Значение); КонецЕсли;
        КонецЕсли;
        Возврат Core.Успех(Пути, Пути, "desktop wallpaper config");
    КонецЕсли;
    Возврат Core.Нет("Настройки окружения недоступны", Модуль);
КонецФункции

Функция Снимок()
    Результат = Новый Структура("time,cpu,disk,net,processes", ТекущаяУниверсальнаяДатаВМиллисекундах(), Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие);
    Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/stat")) Цикл
        Части = Core.Слова(Линия);
        Если Лев(Части[0], 3) <> "cpu" Или Части.Количество() < 5 Тогда Продолжить; КонецЕсли;
        Всего = 0; Для Индекс = 1 По Мин(8, Части.Количество() - 1) Цикл Всего = Всего + Core.ЧислоБезопасно(Части[Индекс]); КонецЦикла;
        Простой = Core.ЧислоБезопасно(Части[4]); Если Части.Количество() > 5 Тогда Простой = Простой + Core.ЧислоБезопасно(Части[5]); КонецЕсли;
        Результат.cpu.Вставить(Части[0], Новый Структура("total,idle", Всего, Простой));
    КонецЦикла;
    Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/diskstats")) Цикл
        Части = Core.Слова(Линия);
        Если Части.Количество() < 14 Тогда Продолжить; КонецЕсли;
        Результат.disk.Вставить(Части[2], Новый Структура("read,write", Core.ЧислоБезопасно(Части[5]) * 512, Core.ЧислоБезопасно(Части[9]) * 512));
    КонецЦикла;
    Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/net/dev")) Цикл
        Позиция = Найти(Линия, ":"); Если Позиция = 0 Тогда Продолжить; КонецЕсли;
        Имя = СокрЛП(Лев(Линия, Позиция - 1)); Части = Core.Слова(Сред(Линия, Позиция + 1));
        Если Части.Количество() >= 9 Тогда Результат.net.Вставить(Имя, Новый Структура("read,write", Core.ЧислоБезопасно(Части[0]), Core.ЧислоБезопасно(Части[8]))); КонецЕсли;
    КонецЦикла;
    Если Core.Значение(Параметры, "collectTop", Ложь) Тогда
        Для Каждого Каталог Из Core.Файлы("/proc") Цикл
            PID = Core.ЧислоБезопасно(Каталог.Имя); Если PID = 0 Тогда Продолжить; КонецЕсли;
            Данные = Core.Текст(Каталог.ПолноеИмя + "/stat");
            Позиция = 0; Для Индекс = 1 По СтрДлина(Данные) Цикл Если Сред(Данные, Индекс, 1) = ")" Тогда Позиция = Индекс; КонецЕсли; КонецЦикла;
            Если Позиция = 0 Тогда Продолжить; КонецЕсли;
            Части = Core.Слова(Сред(Данные, Позиция + 2)); Если Части.Количество() < 22 Тогда Продолжить; КонецЕсли;
            Имя = Сред(Данные, Найти(Данные, "(") + 1, Позиция - Найти(Данные, "(") - 1);
            Результат.processes.Вставить(PID, Новый Структура("name,ticks,startTime,memory", Имя, Core.ЧислоБезопасно(Части[11]) + Core.ЧислоБезопасно(Части[12]), Части[19], Core.ЧислоБезопасно(СтрЗаменить(Core.Поле(Core.Текст(Каталог.ПолноеИмя + "/status"), "VmRSS"), "kB", "")) * 1024));
        КонецЦикла;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура Измерить(Миллисекунды) Экспорт
    СнимокДо = Снимок(); Приостановить(Миллисекунды); СнимокПосле = Снимок();
    Интервал = Макс(1, СнимокПосле.time - СнимокДо.time) / 1000;
КонецПроцедуры

Функция Нагрузки(Модуль)
    Данные = Новый Массив; Линии = Новый Массив;
    Если Модуль = "CPUUsage" Тогда
        Для Каждого Элемент Из СнимокПосле.cpu Цикл
            До = СнимокДо.cpu.Получить(Элемент.Ключ); Если До = Неопределено Тогда Продолжить; КонецЕсли;
            Разница = Элемент.Значение.total - До.total;
            Если Разница <= 0 Тогда Продолжить; КонецЕсли;
            Процент = Мин(100, Макс(0, 100 * (1 - (Элемент.Значение.idle - До.idle) / Разница)));
            Данные.Добавить(Новый Структура("cpu,percentage", Элемент.Ключ, Процент));
            Если Элемент.Ключ = "cpu" Тогда Линии.Добавить(Core.ФорматЧисла(Процент, 1) + "%"); КонецЕсли;
        КонецЦикла;
    ИначеЕсли Модуль = "Top" Тогда
        Таблица = Новый ТаблицаЗначений; Таблица.Колонки.Добавить("pid"); Таблица.Колонки.Добавить("name"); Таблица.Колонки.Добавить("percentage"); Таблица.Колонки.Добавить("memory");
        Тики = Core.ЧислоБезопасно(Core.ЗапросКоманды("getconf", "CLK_TCK").stdout, 100);
        Для Каждого Элемент Из СнимокПосле.processes Цикл
            До = СнимокДо.processes.Получить(Элемент.Ключ);
            Если До = Неопределено Или До.startTime <> Элемент.Значение.startTime Тогда Продолжить; КонецЕсли;
            СтрокаТаблицы = Таблица.Добавить(); СтрокаТаблицы.pid = Элемент.Ключ; СтрокаТаблицы.name = Элемент.Значение.name;
            СтрокаТаблицы.memory = Элемент.Значение.memory;
            СтрокаТаблицы.percentage = Макс(0, Элемент.Значение.ticks - До.ticks) / Макс(1, Тики) / Интервал * 100;
        КонецЦикла;
        Таблица.Сортировать("percentage Убыв");
        Для Индекс = 0 По Мин(4, Таблица.Количество() - 1) Цикл
            СтрокаТаблицы = Таблица[Индекс];
            Данные.Добавить(Новый Структура("pid,name,cpuPercentage,memory", СтрокаТаблицы.pid, СтрокаТаблицы.name, СтрокаТаблицы.percentage, СтрокаТаблицы.memory));
            Линии.Добавить(СтрокаТаблицы.name + " (" + Core.ФорматЧисла(СтрокаТаблицы.pid) + "): " + Core.ФорматЧисла(СтрокаТаблицы.percentage, 1) + "% CPU");
        КонецЦикла;
    Иначе
        Если Модуль = "DiskIO" Тогда ДоВсе = СнимокДо.disk; ПослеВсе = СнимокПосле.disk; Иначе ДоВсе = СнимокДо.net; ПослеВсе = СнимокПосле.net; КонецЕсли;
        Для Каждого Элемент Из ПослеВсе Цикл
            До = ДоВсе.Получить(Элемент.Ключ); Если До = Неопределено Тогда Продолжить; КонецЕсли;
            Если Модуль = "DiskIO" И Не Core.ЕстьФайл("/sys/block/" + Элемент.Ключ) Тогда Продолжить; КонецЕсли;
            Если Модуль = "DiskIO" И (Лев(Элемент.Ключ, 4) = "loop" Или Лев(Элемент.Ключ, 3) = "ram") Тогда Продолжить; КонецЕсли;
            RX = Макс(0, Элемент.Значение.read - До.read) / Интервал; TX = Макс(0, Элемент.Значение.write - До.write) / Интервал;
            Данные.Добавить(Новый Структура("name,readBytes,writeBytes,readBytesPerSecond,writeBytesPerSecond", Элемент.Ключ, Элемент.Значение.read, Элемент.Значение.write, RX, TX));
            Линии.Добавить(Элемент.Ключ + ": " + Core.ФорматЧисла(RX / 1024, 1) + " / " + Core.ФорматЧисла(TX / 1024, 1) + " KiB/s");
        КонецЦикла;
    КонецЕсли;
    Возврат Core.Успех(Новый Структура("intervalSeconds,items", Интервал, Данные), Линии, "shared two-snapshot /proc sampling");
КонецФункции

Функция Сеть(Модуль)
    Если Модуль = "Wifi" Тогда
        Р = Core.ЗапросКоманды("nmcli", "-t|-f|IN-USE,SSID,SIGNAL,FREQ,CHAN,SECURITY|device|wifi|list|--rescan|no");
        Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
        Соединения = Новый Массив;
        Для Каждого Линия Из Core.СписокСтрок(Р.stdout) Цикл
            Если Лев(Линия, 2) = "*:" Тогда Соединения.Добавить(Сред(Линия, 3)); КонецЕсли;
        КонецЦикла;
        Возврат Core.Успех(Новый Структура("connectedNetworks", Соединения), Соединения, "nmcli active Wi-Fi; no rescan");
    КонецЕсли;
    Если Модуль = "DNS" Тогда
        Р = Core.ЗапросКоманды("resolvectl", "dns");
        Если Р.status = "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
        Серверы = Новый Массив;
        Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/etc/resolv.conf")) Цикл
            Части = Core.Слова(Линия); Если Части.Количество() >= 2 И Части[0] = "nameserver" Тогда Серверы.Добавить(Части[1]); КонецЕсли;
        КонецЦикла;
        Возврат Core.Успех(Новый Структура("servers", Серверы), Серверы, "/etc/resolv.conf (resolver endpoints)");
    КонецЕсли;
    Р = Core.ЗапросКоманды("ip", "-j|address|show"); Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
    Маршрут = Core.ЗапросКоманды("ip", "-j|route|show|default"); Интерфейс = "";
    Если Маршрут.status = "ok" Тогда Для Каждого Путь Из Core.JSON(Маршрут.stdout) Цикл Интерфейс = Core.Значение(Путь, "dev"); Если Интерфейс <> "" Тогда Прервать; КонецЕсли; КонецЦикла; КонецЕсли;
    Данные = Новый Массив; Линии = Новый Массив;
    Для Каждого Адаптер Из Core.JSON(Р.stdout) Цикл
        Если Адаптер.ifname = "lo" Тогда Продолжить; КонецЕсли;
        Данные.Добавить(Адаптер);
        Если Адаптер.ifname <> Интерфейс И Интерфейс <> "" Тогда Продолжить; КонецЕсли;
        Для Каждого Адрес Из Адаптер.addr_info Цикл
            Если Адрес.family = "inet" Тогда Линии.Добавить(Адаптер.ifname + ": " + Адрес.local + "/" + Core.ФорматЧисла(Адрес.prefixlen)); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Core.Успех(Новый Структура("defaultInterface,interfaces", Интерфейс, Данные), Линии, "ip JSON, default route");
КонецФункции

Функция УстройстваВвода(Модуль)
    Данные = Новый Массив; Линии = Новый Массив;
    Для Каждого Блок Из Core.Блоки(Core.Текст("/proc/bus/input/devices")) Цикл
        Обработчики = Core.Поле(Блок, "H", ":");
        Нужно = ?(Модуль = "Keyboard", "kbd", ?(Модуль = "Mouse", "mouse", "js"));
        Если Найти(Обработчики, Нужно) = 0 Тогда Продолжить; КонецЕсли;
        Имя = Core.БезКавычек(СтрЗаменить(Core.Поле(Блок, "N", ":"), "Name=", ""));
        Данные.Добавить(Новый Структура("name,handlers,identity", Имя, Обработчики, Core.Поле(Блок, "I", ":"))); Линии.Добавить(Имя);
    КонецЦикла;
    Возврат Core.Успех(Данные, Линии, "/proc/bus/input/devices");
КонецФункции

Функция Питание(Модуль)
    Данные = Новый Массив; Линии = Новый Массив;
    Для Каждого Папка Из Core.Файлы("/sys/class/power_supply") Цикл
        Путь = Папка.ПолноеИмя + "/"; ТипУстройства = СокрЛП(Core.Текст(Путь + "type"));
        Если Модуль = "Battery" И ТипУстройства <> "Battery" Тогда Продолжить; КонецЕсли;
        Если Модуль = "PowerAdapter" И ТипУстройства = "Battery" Тогда Продолжить; КонецЕсли;
        Устройство = Новый Структура("name,type,status,percentage,online,vendor,model,energyFull,energyFullDesign,powerNow", Папка.Имя, ТипУстройства, СокрЛП(Core.Текст(Путь + "status")), Core.ЧислоБезопасно(Core.Текст(Путь + "capacity"), Неопределено), Core.ЧислоБезопасно(Core.Текст(Путь + "online"), Неопределено), СокрЛП(Core.Текст(Путь + "manufacturer")), СокрЛП(Core.Текст(Путь + "model_name")), Core.ЧислоБезопасно(Core.Текст(Путь + "energy_full"), Неопределено), Core.ЧислоБезопасно(Core.Текст(Путь + "energy_full_design"), Неопределено), Core.ЧислоБезопасно(Core.Текст(Путь + "power_now"), Неопределено));
        Данные.Добавить(Устройство);
        Линии.Добавить(Папка.Имя + ": " + ?(Модуль = "Battery", Строка(Устройство.percentage) + "% " + Устройство.status, ТипУстройства + " online=" + Строка(Устройство.online)));
    КонецЦикла;
    Возврат Core.Успех(Данные, Линии, "power_supply sysfs");
КонецФункции

Функция Звук()
    Р = Core.ЗапросКоманды("pactl", "-f|json|list|sinks");
    Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
    Данные = Core.JSON(Р.stdout); Линии = Новый Массив;
    Для Каждого Устройство Из Данные Цикл
        Процент = ""; Для Каждого Канал Из Core.Значение(Устройство, "volume", Новый Структура) Цикл Процент = Core.Значение(Канал.Значение, "value_percent"); Прервать; КонецЦикла;
        Линии.Добавить(Устройство.description + ": " + Процент + ?(Устройство.mute, " (mute)", ""));
    КонецЦикла;
    Возврат Core.Успех(Данные, Линии, "PulseAudio/PipeWire pactl JSON");
КонецФункции

Функция ТерминальныеНастройки(Модуль)
    Терминал = ТерминалОболочка("Terminal");
    Если Модуль = "TerminalSize" Тогда
        Р = Core.ЗапросКоманды("stty", "-F|/dev/tty|size");
        Если Р.status <> "ok" Тогда Возврат Core.Нет("Нет управляющего TTY", "stty", "unavailable"); КонецЕсли;
        Части = Core.Слова(Р.stdout);
        Если Части.Количество() < 2 Тогда Возврат Core.Нет("TTY отсутствует", "stty"); КонецЕсли;
        Возврат Core.Успех(Новый Структура("rows,columns", Core.ЧислоБезопасно(Части[0]), Core.ЧислоБезопасно(Части[1])), Части[1] + "x" + Части[0], "TTY stty");
    КонецЕсли;
    Имя = ?(Терминал.status = "ok", Терминал.data.name, "");
    Если Имя = "konsole" Тогда
        Профиль = Конфиг("konsolerc", "Desktop Entry", "DefaultProfile");
        Если Профиль = "" Тогда Профиль = Конфиг("konsolerc", "General", "DefaultProfile"); КонецЕсли;
        Для Каждого Корень Из Список(Core.Среда("HOME") + "/.local/share/konsole|/usr/share/konsole") Цикл
            Если Модуль = "TerminalFont" Тогда Значение = Core.INI(Корень + "/" + Профиль, "Appearance", "Font");
            Иначе Значение = Core.INI(Корень + "/" + Профиль, "Appearance", "ColorScheme"); КонецЕсли;
            Если Значение <> "" Тогда Возврат Core.Успех(Новый Структура("value,profile", Значение, Профиль), Значение, "Konsole default profile (runtime override may differ)"); КонецЕсли;
        КонецЦикла;
    ИначеЕсли Имя = "kitty" Тогда
        Ключ = ?(Модуль = "TerminalFont", "font_family", "background");
        Для Каждого Линия Из Core.СписокСтрок(Core.Текст(Core.Среда("HOME") + "/.config/kitty/kitty.conf")) Цикл
            Если Лев(Линия, СтрДлина(Ключ) + 1) = Ключ + " " Тогда Возврат СтрокаДанных(Сред(Линия, СтрДлина(Ключ) + 2), "kitty config"); КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Возврат Core.Нет("Активный профиль терминала недоступен; значение не подставляется из другого терминала", "terminal settings");
КонецФункции

Функция ГрафическийAPI(Модуль)
    Если Модуль = "OpenGL" Тогда
        Р = Core.ЗапросКоманды("glxinfo", "-B"); Если Р.status <> "ok" Тогда Р = Core.ЗапросКоманды("eglinfo", "-B"); КонецЕсли;
        Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
        Вер = Core.Поле(Р.stdout, "OpenGL core profile version string");
        Если Вер = "" Тогда Вер = Core.Поле(Р.stdout, "OpenGL core profile version"); КонецЕсли;
        Если Вер = "" Тогда Вер = Core.Поле(Р.stdout, "OpenGL version string"); КонецЕсли;
        Vendor = Core.Поле(Р.stdout, "OpenGL vendor string"); Renderer = Core.Поле(Р.stdout, "OpenGL renderer string");
        Возврат Core.Успех(Новый Структура("version,vendor,renderer,glsl,esVersion,raw", Вер, Vendor, Renderer, Core.Поле(Р.stdout, "OpenGL shading language version string"), Core.Поле(Р.stdout, "OpenGL ES profile version string"), Р.stdout), ?(Вер = "", "EGL: подробности в JSON", Вер + " — " + Renderer), Р.source);
    ИначеЕсли Модуль = "Vulkan" Тогда
        Р = Core.ЗапросКоманды("vulkaninfo", "--summary"); Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
        Устройства = Новый Массив; Линии = Новый Массив; Блок = "";
        Для Каждого Линия Из Core.СписокСтрок(Р.stdout) Цикл
            Если Лев(Линия, 3) = "GPU" И Прав(Линия, 1) = ":" Тогда
                Если Блок <> "" Тогда Устройства.Добавить(Блок); КонецЕсли; Блок = "";
            ИначеЕсли Найти(Линия, "=") > 0 Тогда Блок = Блок + Линия + Символы.ПС; КонецЕсли;
        КонецЦикла;
        Если Блок <> "" Тогда Устройства.Добавить(Блок); КонецЕсли;
        Данные = Новый Массив;
        Для Каждого Блок Из Устройства Цикл
            Д = Новый Структура("name,apiVersion,driverVersion,type,driverName,driverInfo", Core.Поле(Блок, "deviceName", "="), Core.Поле(Блок, "apiVersion", "="), Core.Поле(Блок, "driverVersion", "="), Core.Поле(Блок, "deviceType", "="), Core.Поле(Блок, "driverName", "="), Core.Поле(Блок, "driverInfo", "="));
            Если Д.name <> "" Тогда Данные.Добавить(Д); Линии.Добавить(Д.apiVersion + " — " + Д.name); КонецЕсли;
        КонецЦикла;
        Возврат Core.Успех(Новый Структура("instanceVersion,devices,raw", Core.Поле(Р.stdout, "Vulkan Instance Version"), Данные, Р.stdout), Линии, Р.source);
    Иначе
        Р = Core.ЗапросКоманды("clinfo", "--raw"); Если Р.status <> "ok" Тогда Возврат Core.ИзКоманды(Р); КонецЕсли;
        Устройства = Новый Соответствие;
        Для Каждого Линия Из Core.СписокСтрок(Р.stdout) Цикл
            Если Лев(Линия, 1) <> "[" Тогда Продолжить; КонецЕсли;
            Ключ = Лев(Линия, Найти(Линия, "]"));
            Если Найти(Ключ, "/*]") > 0 Тогда Продолжить; КонецЕсли;
            Д = Устройства.Получить(Ключ); Если Д = Неопределено Тогда Д = Новый Структура("name,vendor,version,type", "", "", "", ""); Устройства.Вставить(Ключ, Д); КонецЕсли;
            Поля = Список("CL_DEVICE_NAME|name|CL_DEVICE_VENDOR|vendor|CL_DEVICE_VERSION|version|CL_DEVICE_TYPE|type");
            Для Индекс = 0 По 6 Цикл
                Если Индекс % 2 <> 0 Тогда Продолжить; КонецЕсли;
                Позиция = Найти(Линия, Поля[Индекс] + " ");
                Если Позиция > 0 Тогда Д.Вставить(Поля[Индекс + 1], СокрЛП(Сред(Линия, Позиция + СтрДлина(Поля[Индекс])))); КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        Данные = Новый Массив; Линии = Новый Массив;
        Для Каждого Элемент Из Устройства Цикл Если Элемент.Значение.name <> "" Тогда Данные.Добавить(Элемент.Значение); Линии.Добавить(Элемент.Значение.version + " — " + Элемент.Значение.name); КонецЕсли; КонецЦикла;
        Возврат Core.Успех(Новый Структура("devices,raw", Данные, Р.stdout), Линии, Р.source);
    КонецЕсли;
КонецФункции

Функция Медиа(Модуль)
    Если Кеш.Получить("media") = Неопределено Тогда
        Р = Core.ЗапросКоманды("qdbus6", "org.freedesktop.DBus|/org/freedesktop/DBus|org.freedesktop.DBus.ListNames");
        Если Р.status <> "ok" Тогда Р = Core.ЗапросКоманды("qdbus", "org.freedesktop.DBus|/org/freedesktop/DBus|org.freedesktop.DBus.ListNames"); КонецЕсли;
        Данные = Новый Массив;
        Если Р.status = "ok" Тогда
            Для Каждого Имя Из Core.СписокСтрок(Р.stdout) Цикл
                Если Лев(Имя, СтрДлина("org.mpris.MediaPlayer2.")) <> "org.mpris.MediaPlayer2." Тогда Продолжить; КонецЕсли;
                Prefix = Имя + "|/org/mpris/MediaPlayer2|";
                Метаданные = Core.ЗапросКоманды(Р.source, Prefix + "org.mpris.MediaPlayer2.Player.Metadata");
                Статус = Core.ЗапросКоманды(Р.source, Prefix + "org.mpris.MediaPlayer2.Player.PlaybackStatus");
                Identity = Core.ЗапросКоманды(Р.source, Prefix + "org.mpris.MediaPlayer2.Identity");
                Данные.Добавить(Новый Структура("name,identity,status,title,artist,album,raw", Имя, СокрЛП(Identity.stdout), СокрЛП(Статус.stdout), Core.Префикс(Метаданные.stdout, "xesam:title:"), Core.Префикс(Метаданные.stdout, "xesam:artist:"), Core.Префикс(Метаданные.stdout, "xesam:album:"), Метаданные.stdout));
            КонецЦикла;
            Кеш.Вставить("media", Core.Успех(Данные, "", "MPRIS D-Bus via " + Р.source));
        Иначе
            Р = Core.ЗапросКоманды("playerctl", "metadata|--format|{{playerName}} — {{artist}} — {{title}} ({{album}})");
            Кеш.Вставить("media", Core.ИзКоманды(Р));
        КонецЕсли;
    КонецЕсли;
    Р = Кеш.Получить("media"); Если Р.status <> "ok" Или ТипЗнч(Р.data) <> Тип("Массив") Тогда Возврат Р; КонецЕсли;
    Линии = Новый Массив;
    Для Каждого Д Из Р.data Цикл
        Если Модуль = "Player" Тогда Линии.Добавить(Д.identity + " (" + Д.status + ")");
        ИначеЕсли Д.title <> "" Тогда Линии.Добавить(?(Д.artist = "", "", Д.artist + " — ") + Д.title); КонецЕсли;
    КонецЦикла;
    Возврат Core.Успех(Р.data, Линии, Р.source);
КонецФункции

Функция Специальный(Модуль)
    Если Список("OpenGL|OpenCL|Vulkan").Найти(Модуль) <> Неопределено Тогда Возврат ГрафическийAPI(Модуль);
    ИначеЕсли Модуль = "Media" Или Модуль = "Player" Тогда Возврат Медиа(Модуль);
    ИначеЕсли Модуль = "Codec" Тогда
        Р = Core.ЗапросКоманды("vainfo"); Если Р.status <> "ok" Тогда Р = Core.ЗапросКоманды("vdpauinfo"); КонецЕсли;
    ИначеЕсли Модуль = "PhysicalMemory" Тогда Р = Core.ЗапросКоманды("dmidecode", "--type|17");
    ИначеЕсли Модуль = "Bootmgr" Тогда Р = Core.ЗапросКоманды("bootctl", "status|--no-pager");
    ИначеЕсли Модуль = "Btrfs" Тогда Р = Core.ЗапросКоманды("btrfs", "filesystem|show|--raw");
    ИначеЕсли Модуль = "Zpool" Тогда Р = Core.ЗапросКоманды("zpool", "list|-Hp|-o|name,size,alloc,free,health");
    ИначеЕсли Модуль = "TPM" Тогда
        Если Core.Файлы("/sys/class/tpm", "tpm*").Количество() = 0 Тогда Возврат Core.Успех(Новый Массив, "", "TPM sysfs: no devices"); КонецЕсли;
        Р = Core.ЗапросКоманды("tpm2_getcap", "properties-fixed");
        Если Р.status = "unavailable" Тогда
            Данные = Новый Массив; Линии = Новый Массив;
            Для Каждого Папка Из Core.Файлы("/sys/class/tpm", "tpm*") Цикл
                ВерсияTPM = СокрЛП(Core.Текст(Папка.ПолноеИмя + "/tpm_version_major"));
                Данные.Добавить(Новый Структура("device,version,detailStatus", Папка.Имя, ВерсияTPM, Р.status)); Линии.Добавить(Папка.Имя + ": TPM " + ВерсияTPM);
            КонецЦикла;
            Возврат Core.Успех(Данные, Линии, "TPM sysfs; tpm2-tools details unavailable");
        КонецЕсли;
    ИначеЕсли Модуль = "Bluetooth" Тогда Р = Core.ЗапросКоманды("bluetoothctl", "devices|Connected");
    ИначеЕсли Модуль = "BluetoothRadio" Тогда Р = Core.ЗапросКоманды("bluetoothctl", "list");
    ИначеЕсли Модуль = "Media" Тогда Р = Core.ЗапросКоманды("playerctl", "metadata|--format|{{artist}} — {{title}} ({{album}})");
    ИначеЕсли Модуль = "Player" Тогда Р = Core.ЗапросКоманды("playerctl", "--list-all");
    ИначеЕсли Модуль = "Users" Тогда Р = Core.ЗапросКоманды("who");
    ИначеЕсли Модуль = "LM" Тогда Р = Core.ЗапросКоманды("systemctl", "show|display-manager.service|--property=Id,FragmentPath,ActiveState|--no-pager");
    ИначеЕсли Модуль = "Brightness" Тогда
        Данные = Новый Массив; Линии = Новый Массив;
        Для Каждого Папка Из Core.Файлы("/sys/class/backlight") Цикл
            МаксЗначение = Core.ЧислоБезопасно(Core.Текст(Папка.ПолноеИмя + "/max_brightness"));
            Значение = Core.ЧислоБезопасно(Core.Текст(Папка.ПолноеИмя + "/actual_brightness"));
            Данные.Добавить(Новый Структура("name,value,maxValue,percentage", Папка.Имя, Значение, МаксЗначение, Core.Процент(Значение, МаксЗначение)));
            Линии.Добавить(Папка.Имя + ": " + Core.ФорматЧисла(Core.Процент(Значение, МаксЗначение)) + "%");
        КонецЦикла;
        Если Данные.Количество() > 0 Тогда Возврат Core.Успех(Данные, Линии, "backlight sysfs"); КонецЕсли;
        Р = Core.ЗапросКоманды("ddcutil", "getvcp|10|--terse");
    ИначеЕсли Модуль = "Camera" Тогда
        Данные = Новый Массив; Линии = Новый Массив;
        Для Каждого Папка Из Core.Файлы("/sys/class/video4linux") Цикл
            Имя = СокрЛП(Core.Текст(Папка.ПолноеИмя + "/name")); Данные.Добавить(Новый Структура("name,device", Имя, "/dev/" + Папка.Имя)); Линии.Добавить(Имя);
        КонецЦикла;
        Возврат Core.Успех(Данные, Линии, "V4L2 sysfs enumeration");
    Иначе Возврат Core.Нет("Неизвестный модуль", Модуль, "error"); КонецЕсли;
    Возврат Core.ИзКоманды(Р);
КонецФункции

Функция Собрать(Модуль) Экспорт
    Если Модуль = "OS" Тогда Возврат ОС();
    ИначеЕсли Список("Host|Board|BIOS|Chassis").Найти(Модуль) <> Неопределено Тогда Возврат Компьютер(Модуль);
    ИначеЕсли Модуль = "Kernel" Тогда Возврат Ядро();
    ИначеЕсли Модуль = "CPU" Тогда Возврат ЦП();
    ИначеЕсли Модуль = "CPUCache" Тогда Возврат КешЦП();
    ИначеЕсли Список("Memory|Swap").Найти(Модуль) <> Неопределено Тогда Возврат Память(Модуль);
    ИначеЕсли Модуль = "Packages" Тогда Возврат Пакеты();
    ИначеЕсли Список("Disk|PhysicalDisk").Найти(Модуль) <> Неопределено Тогда Возврат Диски(Модуль);
    ИначеЕсли Модуль = "GPU" Тогда Возврат Видеокарты();
    ИначеЕсли Список("Display|Monitor").Найти(Модуль) <> Неопределено Тогда Возврат Экраны(Модуль);
    ИначеЕсли Список("Shell|Terminal").Найти(Модуль) <> Неопределено Тогда Возврат ТерминалОболочка(Модуль);
    ИначеЕсли Список("DE|WM|WMTheme|Theme|Icons|Font|Cursor|Wallpaper").Найти(Модуль) <> Неопределено Тогда Возврат Оформление(Модуль);
    ИначеЕсли Список("CPUUsage|DiskIO|NetIO|Top").Найти(Модуль) <> Неопределено Тогда Возврат Нагрузки(Модуль);
    ИначеЕсли Список("LocalIp|DNS|Wifi").Найти(Модуль) <> Неопределено Тогда Возврат Сеть(Модуль);
    ИначеЕсли Список("Keyboard|Mouse|Gamepad").Найти(Модуль) <> Неопределено Тогда Возврат УстройстваВвода(Модуль);
    ИначеЕсли Список("Battery|PowerAdapter").Найти(Модуль) <> Неопределено Тогда Возврат Питание(Модуль);
    ИначеЕсли Модуль = "Sound" Тогда Возврат Звук();
    ИначеЕсли Список("TerminalFont|TerminalTheme|TerminalSize").Найти(Модуль) <> Неопределено Тогда Возврат ТерминальныеНастройки(Модуль);
    ИначеЕсли Модуль = "Uptime" Тогда
        Секунды = Core.ЧислоБезопасно(Core.Слова(Core.Текст("/proc/uptime"))[0]); Возврат Core.Успех(Новый Структура("seconds", Секунды), Core.Время(Секунды), "/proc/uptime");
    ИначеЕсли Модуль = "Loadavg" Тогда
        Части = Core.Слова(Core.Текст("/proc/loadavg")); Возврат Core.Успех(Новый Структура("one,five,fifteen", Core.ЧислоБезопасно(Части[0]), Core.ЧислоБезопасно(Части[1]), Core.ЧислоБезопасно(Части[2])), Части[0] + ", " + Части[1] + ", " + Части[2], "/proc/loadavg");
    ИначеЕсли Модуль = "Processes" Тогда
        Количество = 0; Потоки = 0;
        Для Каждого Папка Из Core.Файлы("/proc") Цикл
            Если Core.ЧислоБезопасно(Папка.Имя) = 0 Тогда Продолжить; КонецЕсли;
            Статус = Core.Текст(Папка.ПолноеИмя + "/status"); Если Статус = "" Тогда Продолжить; КонецЕсли;
            Количество = Количество + 1; Потоки = Потоки + Core.ЧислоБезопасно(Core.Поле(Статус, "Threads"));
        КонецЦикла;
        Возврат Core.Успех(Новый Структура("processes,threads", Количество, Потоки), Core.ФорматЧисла(Количество) + " процессов, " + Core.ФорматЧисла(Потоки) + " потоков", "/proc");
    ИначеЕсли Модуль = "InitSystem" Тогда
        Имя = Core.Поле(Core.Текст("/proc/1/status"), "Name"); Возврат СтрокаДанных(Имя + " " + Версия(Имя), "PID 1");
    КонецЕсли;
    Возврат Специальный(Модуль);
КонецФункции

Кеш = Новый Соответствие; Параметры = Новый Структура;
