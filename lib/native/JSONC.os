#native
// Разбор JSONC на языке 1С: статические строки, индексы и состояния.

Функция Очистить(ИсходныйТекст) Экспорт
    // JSONC: комментарии удаляются только за пределами строк.
    Текст = Строка(ИсходныйТекст); Чистый = ""; ВСтроке = Ложь; Escape = Ложь; Индекс = 1;
    Пока Индекс <= СтрДлина(Текст) Цикл
        Знак = Сред(Текст, Индекс, 1); Следующий = Сред(Текст, Индекс + 1, 1);
        Если ВСтроке Тогда
            Чистый = Чистый + Знак;
            Если Escape Тогда Escape = Ложь;
            ИначеЕсли Знак = "\" Тогда Escape = Истина;
            ИначеЕсли Знак = Символ(34) Тогда ВСтроке = Ложь; КонецЕсли;
        ИначеЕсли Знак = Символ(34) Тогда ВСтроке = Истина; Чистый = Чистый + Знак;
        ИначеЕсли Знак = "/" И Следующий = "/" Тогда
            Пока Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) <> Символы.ПС Цикл Индекс = Индекс + 1; КонецЦикла;
            Чистый = Чистый + Символы.ПС;
        ИначеЕсли Знак = "/" И Следующий = "*" Тогда
            Индекс = Индекс + 2;
            Пока Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 2) <> "*/" Цикл Индекс = Индекс + 1; КонецЦикла;
            Индекс = Индекс + 1; Чистый = Чистый + " ";
        Иначе Чистый = Чистый + Знак; КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;
    // JSONC допускает завершающую запятую перед ] или }, но не внутри строки.
    Текст = Чистый; Чистый = ""; ВСтроке = Ложь; Escape = Ложь;
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Знак = Сред(Текст, Индекс, 1); Пропустить = Ложь;
        Если ВСтроке Тогда
            Если Escape Тогда Escape = Ложь;
            ИначеЕсли Знак = "\" Тогда Escape = Истина;
            ИначеЕсли Знак = Символ(34) Тогда ВСтроке = Ложь; КонецЕсли;
        ИначеЕсли Знак = Символ(34) Тогда ВСтроке = Истина;
        ИначеЕсли Знак = "," Тогда
            Позиция = Индекс + 1;
            Пока Позиция <= СтрДлина(Текст) И Найти(" " + Символы.Таб + Символы.ПС + Символы.ВК, Сред(Текст, Позиция, 1)) > 0 Цикл Позиция = Позиция + 1; КонецЦикла;
            Пропустить = Сред(Текст, Позиция, 1) = "]" Или Сред(Текст, Позиция, 1) = "}";
        КонецЕсли;
        Если Не Пропустить Тогда Чистый = Чистый + Знак; КонецЕсли;
    КонецЦикла;
    Возврат Чистый;
КонецФункции
