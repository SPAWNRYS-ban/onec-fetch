#native
// Общий снимок счётчиков Linux на языке 1С.
// Native загружается только для CPUUsage, DiskIO, NetIO и Top.

Функция Снимок(СобиратьTop) Экспорт
    ОбработкаТекста = Core.НативныйМодуль("Text");
    Результат = Новый Структура("time,cpu,disk,net,processes", ТекущаяУниверсальнаяДатаВМиллисекундах(), Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие);
    Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/stat")) Цикл
        Части = ОбработкаТекста.Слова(Линия);
        Если Лев(Части[0], 3) <> "cpu" Или Части.Количество() < 5 Тогда Продолжить; КонецЕсли;
        Всего = 0; Для Индекс = 1 По Мин(8, Части.Количество() - 1) Цикл Всего = Всего + ОбработкаТекста.ЧислоБезопасно(Части[Индекс]); КонецЦикла;
        Простой = ОбработкаТекста.ЧислоБезопасно(Части[4]); Если Части.Количество() > 5 Тогда Простой = Простой + ОбработкаТекста.ЧислоБезопасно(Части[5]); КонецЕсли;
        Результат.cpu.Вставить(Части[0], Новый Структура("total,idle", Всего, Простой));
    КонецЦикла;
    Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/diskstats")) Цикл
        Части = ОбработкаТекста.Слова(Линия);
        Если Части.Количество() < 14 Тогда Продолжить; КонецЕсли;
        Результат.disk.Вставить(Части[2], Новый Структура("read,write", ОбработкаТекста.ЧислоБезопасно(Части[5]) * 512, ОбработкаТекста.ЧислоБезопасно(Части[9]) * 512));
    КонецЦикла;
    Для Каждого Линия Из Core.СписокСтрок(Core.Текст("/proc/net/dev")) Цикл
        Позиция = Найти(Линия, ":"); Если Позиция = 0 Тогда Продолжить; КонецЕсли;
        Имя = СокрЛП(Лев(Линия, Позиция - 1)); Части = ОбработкаТекста.Слова(Сред(Линия, Позиция + 1));
        Если Части.Количество() >= 9 Тогда Результат.net.Вставить(Имя, Новый Структура("read,write", ОбработкаТекста.ЧислоБезопасно(Части[0]), ОбработкаТекста.ЧислоБезопасно(Части[8]))); КонецЕсли;
    КонецЦикла;
    Если СобиратьTop Тогда
        Для Каждого Каталог Из Core.Файлы("/proc") Цикл
            PID = ОбработкаТекста.ЧислоБезопасно(Каталог.Имя); Если PID = 0 Тогда Продолжить; КонецЕсли;
            Данные = Строка(Core.Текст(Каталог.ПолноеИмя + "/stat"));
            Позиция = 0; Для Индекс = 1 По СтрДлина(Данные) Цикл Если Сред(Данные, Индекс, 1) = ")" Тогда Позиция = Индекс; КонецЕсли; КонецЦикла;
            Если Позиция = 0 Тогда Продолжить; КонецЕсли;
            Части = ОбработкаТекста.Слова(Сред(Данные, Позиция + 2)); Если Части.Количество() < 22 Тогда Продолжить; КонецЕсли;
            Имя = Сред(Данные, Найти(Данные, "(") + 1, Позиция - Найти(Данные, "(") - 1);
            Результат.processes.Вставить(PID, Новый Структура("name,ticks,startTime,memory", Имя, ОбработкаТекста.ЧислоБезопасно(Части[11]) + ОбработкаТекста.ЧислоБезопасно(Части[12]), Части[19], ОбработкаТекста.ЧислоБезопасно(СтрЗаменить(ОбработкаТекста.Поле(Core.Текст(Каталог.ПолноеИмя + "/status"), "VmRSS"), "kB", "")) * 1024));
        КонецЦикла;
    КонецЕсли;
    Возврат Результат;
КонецФункции
