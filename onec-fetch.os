#Использовать "lib"
// onec-fetch 2.0: модульная программа на языке 1С / OneScript.
Перем СИ, Цвет;

Функция ФайлТекст(Путь)
    Возврат Core.Текст(Путь);
КонецФункции
Функция ЦелоеТекст(Значение)
    Возврат Core.ФорматЧисла(Значение);
КонецФункции
Функция Среда(Имя)
    Возврат Core.Среда(Имя);
КонецФункции
Функция БезКавычек(Значение)
    Значение = СокрЛП(Значение);
    Если СтрДлина(Значение) >= 2 Тогда
        Первый = Лев(Значение, 1);
        Если (Первый = Символ(34) Или Первый = "'") И Прав(Значение, 1) = Первый Тогда
            Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
        КонецЕсли;
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция КаталогЛоготипов()
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(ФайлТекст(ТекущийСценарий().Каталог + "/assets/logos.json"));
        Результат = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Возврат Результат;
    Исключение
        // Без каталога assets остаётся логотип 1С; lib нужен для запуска.
        Возврат Новый Структура;
    КонецПопытки;
КонецФункции

Функция ИмяЛоготипа(Каталог, Имя)
    Имя = НРег(СокрЛП(Имя));
    Для Каждого Элемент Из Каталог Цикл
        Если НРег(Элемент.Ключ) = Имя Или Элемент.Значение.aliases.Найти(Имя) <> Неопределено Тогда
            Возврат Элемент.Ключ;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция АвтоЛоготип(Каталог, Данные)
    // Точный ID имеет приоритет над названием и семейством дистрибутива.
    Имя = ИмяЛоготипа(Каталог, Данные.os_id);
    Если Имя <> "" Тогда Возврат Имя; КонецЕсли;
    Имя = ИмяЛоготипа(Каталог, Данные.os);
    Если Имя <> "" Тогда Возврат Имя; КонецЕсли;
    Для Каждого Семейство Из СтрРазделить(Данные.os_id_like, " ", Ложь) Цикл
        Имя = ИмяЛоготипа(Каталог, Семейство);
        Если Имя <> "" Тогда Возврат Имя; КонецЕсли;
    КонецЦикла;
    ОС = НРег(Данные.os);
    Ядро = НРег(Данные.kernel);
    Если Найти(ОС, "windows") > 0 Или Найти(Ядро, "windows") > 0 Или Найти(Ядро, "win32") > 0 Тогда
        Если Найти(ОС, "2025") > 0 Тогда Возврат "windows_2025"; КонецЕсли;
        Если Найти(ОС, "windows 11") > 0 Или Найти(ОС, "2022") > 0 Тогда Возврат "windows_11"; КонецЕсли;
        Если Найти(ОС, "windows 10") > 0 Или Найти(ОС, "windows 8") > 0
            Или Найти(ОС, "2012") > 0 Или Найти(ОС, "2016") > 0 Или Найти(ОС, "2019") > 0 Тогда
            Возврат "windows_8";
        КонецЕсли;
        Возврат "windows";
    КонецЕсли;
    Если Найти(Ядро, "darwin") > 0 Или Найти(ОС, "macos") > 0 Тогда Возврат "macos"; КонецЕсли;
    Для Каждого Семейство Из СтрРазделить("freebsd openbsd netbsd dragonfly", " ") Цикл
        Если Найти(Ядро, Семейство) > 0 Или Найти(ОС, Семейство) > 0 Тогда Возврат Семейство; КонецЕсли;
    КонецЦикла;
    Если Найти(Ядро, "linux") > 0 Тогда Возврат "linux"; КонецЕсли;
    Возврат "unknown";
КонецФункции

Функция Логотип1С()
    Линии = СтрРазделить("                          
        |    111      CCCCCCCCC
        |  11111    CCC      CCC
        |    111   CCC
        |    111   CCC
        |    111   CCC
        |    111   CCC
        |    111    CCC      CCC
        |  1111111    CCCCCCCCC
        |
        |        onec-fetch", Символы.ПС);
    Палитра = Новый Массив;
    Палитра.Добавить("31");
    Возврат Новый Структура("lines,colors", Линии, Палитра);
КонецФункции

Функция Логотип(Каталог, Данные, Выбор)
    Если Выбор = "1c" Тогда Возврат Логотип1С(); КонецЕсли;
    Если Выбор = "auto" Тогда Выбор = АвтоЛоготип(Каталог, Данные); КонецЕсли;
    Имя = ИмяЛоготипа(Каталог, Выбор);
    Если Имя = "" Тогда Возврат Логотип1С(); КонецЕсли;
    Результат = Неопределено;
    Каталог.Свойство(Имя, Результат);
    Возврат Результат;
КонецФункции

Функция БезМаркеров(Линия)
    Для Номер = 1 По 9 Цикл
        Линия = СтрЗаменить(Линия, "$" + ЦелоеТекст(Номер), "");
    КонецЦикла;
    Возврат Линия;
КонецФункции

Функция РаскраситьЛоготип(Линия, Палитра, ТекущийЦвет)
    Результат = "";
    Если Цвет Тогда Результат = Символ(27) + "[1;" + ТекущийЦвет + "m"; КонецЕсли;
    Индекс = 1;
    Пока Индекс <= СтрДлина(Линия) Цикл
        Знак = Сред(Линия, Индекс, 1);
        Номер = 0;
        Если Знак = "$" И Индекс < СтрДлина(Линия) Тогда
            Номер = Найти("123456789", Сред(Линия, Индекс + 1, 1));
        КонецЕсли;
        Если Номер > 0 Тогда
            Если Палитра.Количество() > 0 Тогда
                ТекущийЦвет = Палитра[Мин(Номер - 1, Палитра.Количество() - 1)];
            КонецЕсли;
            Если Цвет Тогда Результат = Результат + Символ(27) + "[1;" + ТекущийЦвет + "m"; КонецЕсли;
            Индекс = Индекс + 2;
        Иначе
            Результат = Результат + Знак;
            Индекс = Индекс + 1;
        КонецЕсли;
    КонецЦикла;
    Если Цвет Тогда Результат = Результат + Символ(27) + "[0m"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Окрасить(Текст, Код)
    Возврат ?(Цвет, Символ(27) + "[" + Код + "m" + Текст + Символ(27) + "[0m", Текст);
КонецФункции


Процедура Вывести(Данные, БезЛоготипа, Рисунок, Результаты, Отладка, ШиринаТерминала)
    Лого = Рисунок.lines; Ширина = 0;
    Если Не БезЛоготипа Тогда
        Для Каждого Линия Из Лого Цикл Ширина = Макс(Ширина, СтрДлина(БезМаркеров(Линия))); КонецЦикла;
        Если ШиринаТерминала < Ширина + 42 Тогда БезЛоготипа = Истина; Ширина = 0; КонецЕсли;
    КонецЕсли;
    Строки = Новый Массив;
    Для Каждого Р Из Результаты Цикл
        Если Р.status <> "ok" Тогда
            Если Отладка Тогда Строки.Добавить(Р.key + ": [" + Р.status + "] " + Р.error); КонецЕсли;
            Продолжить;
        КонецЕсли;
        Если Р.type = "Colors" Тогда
            Если Цвет Тогда
                Для Яркость = 0 По 1 Цикл
                    Палитра = "";
                    Для Номер = 40 По 47 Цикл Палитра = Палитра + Окрасить("   ", ЦелоеТекст(Номер + Яркость * 60)); КонецЦикла;
                    Строки.Добавить(Палитра);
                КонецЦикла;
            КонецЕсли;
            Продолжить;
        КонецЕсли;
        Если Р.type = "Title" Тогда Строки.Добавить(Окрасить(Р.display, "1;36")); Продолжить; КонецЕсли;
        Если Р.type = "Separator" Или Р.type = "Break" Тогда Строки.Добавить(Р.display); Продолжить; КонецЕсли;
        Если ТипЗнч(Р.display) = Тип("Массив") Тогда Линии = Р.display;
        Иначе Линии = Core.СписокСтрок(Строка(Р.display)); КонецЕсли;
        Для Каждого Линия Из Линии Цикл
            // Raw utility output is retained in JSON; terminal summary remains bounded.
            Доступно = Макс(1, ШиринаТерминала - ?(БезЛоготипа, 0, Ширина + 2) - СтрДлина(Р.key) - 2);
            Пока СтрДлина(Линия) > Доступно Цикл
                Строки.Добавить(Окрасить(Р.key + ": ", "1;33") + Лев(Линия, Доступно));
                Линия = Сред(Линия, Доступно + 1);
            КонецЦикла;
            Если Линия <> "" Тогда Строки.Добавить(Окрасить(Р.key + ": ", "1;33") + Линия); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    ТекущийЦвет = "37"; Если Рисунок.colors.Количество() > 0 Тогда ТекущийЦвет = Рисунок.colors[0]; КонецЕсли;
    КоличествоСтрок = Строки.Количество(); Если Не БезЛоготипа Тогда КоличествоСтрок = Макс(КоличествоСтрок, Лого.Количество()); КонецЕсли;
    Сообщить("");
    Для Индекс = 0 По КоличествоСтрок - 1 Цикл
        Слева = "";
        Если Не БезЛоготипа Тогда
            Линия = ""; Если Индекс < Лого.Количество() Тогда Линия = Лого[Индекс]; КонецЕсли;
            Отступ = ""; Для Номер = СтрДлина(БезМаркеров(Линия)) + 1 По Ширина Цикл Отступ = Отступ + " "; КонецЦикла;
            Слева = РаскраситьЛоготип(Линия, Рисунок.colors, ТекущийЦвет) + Отступ + "  ";
        КонецЕсли;
        Справа = ""; Если Индекс < Строки.Количество() Тогда Справа = Строки[Индекс]; КонецЕсли;
        Сообщить(Слева + Справа);
    КонецЦикла;
    Сообщить("");
КонецПроцедуры

Процедура Справка()
    Сообщить("onec-fetch 2.0.0 — системная сводка на языке 1С / OneScript");
    Сообщить("Запуск: onec-fetch [--all] [-s CPU:GPU:Memory] [-c config.jsonc]");
    Сообщить("--list-modules, --list-logos, --logo=auto|1c|ИМЯ, --no-logo");
    Сообщить("--json (schema v2 + прежние ключи), --json=legacy, --format=json");
    Сообщить("--color, --no-color, --debug, --width=120, --version, --help");
    Сообщить("--timeout=3000, --interval=200 (мс), --allow-network, --location=МЕСТО");
    Сообщить("--command=КОМАНДА: выполняется только при выбранном модуле Command");
КонецПроцедуры

СИ = Новый СистемнаяИнформация;
Каталог = КаталогЛоготипов();
Цвет = (Среда("TERM") <> "" И Среда("TERM") <> "dumb" Или Среда("WT_SESSION") <> "") И ПеременныеСреды().Получить("NO_COLOR") = Неопределено;
Параметры = Новый Структура("root,timeout,interval,modules,allowNetwork,location,command,logo", ТекущийСценарий().Каталог, 3000, 200, Engine.Обычные(), Ложь, "", "", "auto");
Переопределения = Новый Структура;
БезЛоготипа = Ложь; Отладка = Ложь; JSON = Ложь; СтарыйJSON = Ложь; Ширина = 120; Конфигурация = ""; Ожидание = "";
Попытка
    Для Каждого ИсходныйАргумент Из АргументыКоманднойСтроки Цикл
        Аргумент = ИсходныйАргумент;
        Если Ожидание <> "" Тогда Аргумент = Ожидание + "=" + Аргумент; Ожидание = ""; КонецЕсли;
        Если Core.Арги("--modules|-s|--config|-c|--format|--timeout|--interval|--logo|--width|--location|--command").Найти(Аргумент) <> Неопределено Тогда
            Ожидание = Аргумент; Продолжить;
        КонецЕсли;
        Позиция = Найти(Аргумент, "=");
        Ключ = ?(Позиция > 0, Лев(Аргумент, Макс(0, Позиция - 1)), Аргумент);
        Значение = ?(Позиция > 0, Сред(Аргумент, Позиция + 1), "");
        Если Ключ = "--help" Или Ключ = "-h" Тогда Справка(); ЗавершитьРаботу(0);
        ИначеЕсли Ключ = "--version" Тогда Сообщить("onec-fetch 2.0.0"); ЗавершитьРаботу(0);
        ИначеЕсли Ключ = "--list-modules" Тогда Для Каждого Имя Из Engine.Имена() Цикл Сообщить(Имя); КонецЦикла; ЗавершитьРаботу(0);
        ИначеЕсли Ключ = "--list-logos" Тогда
            Сообщить("auto"); Сообщить("1c"); Для Каждого Элемент Из Каталог Цикл Сообщить(Элемент.Ключ); КонецЦикла; ЗавершитьРаботу(0);
        ИначеЕсли Ключ = "--all" Тогда Переопределения.Вставить("modules", Engine.Имена());
        ИначеЕсли Ключ = "--modules" Или Ключ = "-s" Тогда Переопределения.Вставить("modules", СтрРазделить(СтрЗаменить(Значение, ":", ","), ",", Ложь));
        ИначеЕсли Ключ = "--config" Или Ключ = "-c" Тогда Конфигурация = Значение;
        ИначеЕсли Ключ = "--format" Тогда
            Если Значение <> "json" Тогда ВызватьИсключение "Поддерживается --format=json"; КонецЕсли; JSON = Истина;
        ИначеЕсли Ключ = "--json" Тогда
            JSON = Истина; СтарыйJSON = Значение = "legacy";
            Если Значение <> "" И Значение <> "legacy" Тогда ВызватьИсключение "Используйте --json или --json=legacy"; КонецЕсли;
        ИначеЕсли Ключ = "--logo" Тогда
            Значение = НРег(Значение);
            Если Значение <> "auto" И Значение <> "1c" И ИмяЛоготипа(Каталог, Значение) = "" Тогда ВызватьИсключение "Неизвестный логотип: " + Значение; КонецЕсли;
            Переопределения.Вставить("logo", Значение);
        ИначеЕсли Ключ = "--timeout" Или Ключ = "--interval" Тогда
            ЧислоПараметра = Core.ЧислоБезопасно(Значение, -1);
            Если ЧислоПараметра < 50 Или ЧислоПараметра > 60000 Тогда ВызватьИсключение "Значение должно быть 50..60000 мс"; КонецЕсли;
            Переопределения.Вставить(Сред(Ключ, 3), ЧислоПараметра);
        ИначеЕсли Ключ = "--allow-network" Тогда Переопределения.Вставить("allowNetwork", Истина);
        ИначеЕсли Ключ = "--location" Тогда Переопределения.Вставить("location", Значение);
        ИначеЕсли Ключ = "--command" Тогда Переопределения.Вставить("command", Значение);
        ИначеЕсли Ключ = "--no-logo" Тогда БезЛоготипа = Истина;
        ИначеЕсли Ключ = "--no-color" Тогда Цвет = Ложь;
        ИначеЕсли Ключ = "--color" Тогда Цвет = Истина;
        ИначеЕсли Ключ = "--debug" Тогда Отладка = Истина;
        ИначеЕсли Ключ = "--width" Тогда
            Ширина = Core.ЧислоБезопасно(Значение, -1); Если Ширина < 40 Тогда ВызватьИсключение "Ширина должна быть >= 40"; КонецЕсли;
        Иначе ВызватьИсключение "Неизвестный аргумент: " + Аргумент + ". Используйте --help."; КонецЕсли;
    КонецЦикла;
    Если Ожидание <> "" Тогда ВызватьИсключение "Не задано значение " + Ожидание; КонецЕсли;
    Если Конфигурация <> "" Тогда
        Конфиг = Engine.ЧитатьКонфиг(Конфигурация);
        Для Каждого Параметр Из Параметры Цикл
            Значение = Core.Значение(Конфиг, Параметр.Ключ, Неопределено);
            Если Значение <> Неопределено И Параметр.Ключ <> "root" Тогда Параметры.Вставить(Параметр.Ключ, Значение); КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Для Каждого Параметр Из Переопределения Цикл Параметры.Вставить(Параметр.Ключ, Параметр.Значение); КонецЦикла;
    Если Параметры.modules.Количество() = 0 Тогда ВызватьИсключение "Список модулей пуст"; КонецЕсли;
    Если Параметры.timeout < 50 Или Параметры.timeout > 60000 Или Параметры.interval < 50 Или Параметры.interval > 60000 Тогда ВызватьИсключение "timeout/interval: 50..60000 мс"; КонецЕсли;
    Engine.Начать(Параметры);
    Результаты = Engine.ВсеРезультаты();
    Данные = Engine.СовместимыйJSON();
    Если JSON Тогда
        Если Не СтарыйJSON Тогда Данные.Вставить("schemaVersion", 2); Данные.Вставить("modules", Результаты); КонецЕсли;
        Сообщить(Core.ВJSON(Данные));
    Иначе Вывести(Данные, БезЛоготипа, Логотип(Каталог, Данные, Параметры.logo), Результаты, Отладка, Ширина); КонецЕсли;
Исключение
    Сообщить(ОписаниеОшибки()); ЗавершитьРаботу(2);
КонецПопытки;
