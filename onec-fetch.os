// onec-fetch: сведения о компьютере на языке 1С (OneScript 2.x).
Перем СИ, Цвет;

Функция ФайлТекст(Путь)
    Попытка
        Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
        Текст = Чтение.Прочитать();
        Чтение.Закрыть();
        Возврат ?(Текст = Неопределено, "", Текст);
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

Функция Поле(Текст, Ключ, Разделитель = ":")
    Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС) Цикл
        Позиция = Найти(Стр, Разделитель);
        Если Позиция > 0 И СокрЛП(Лев(Стр, Позиция - 1)) = Ключ Тогда
            Возврат СокрЛП(Сред(Стр, Позиция + 1));
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция Среда(Имя)
    Значение = ПолучитьПеременнуюСреды(Имя);
    Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция ЧислоТекста(Текст)
    // /proc использует точку независимо от локали.
    Возврат Число(СтрЗаменить(Текст, ".", ","));
КонецФункции

Функция ЦелоеТекст(Значение)
    Возврат Формат(Значение, "ЧГ=0; ЧДЦ=0");
КонецФункции

Функция Гиб(Байт)
    Возврат Формат(Байт / 1073741824, "ЧГ=0; ЧДЦ=2") + " GiB";
КонецФункции

Функция ВремяРаботы(Секунды)
    Возврат ЦелоеТекст(Цел(Секунды / 86400)) + " д "
        + ЦелоеТекст(Цел(Секунды / 3600) % 24) + " ч "
        + ЦелоеТекст(Цел(Секунды / 60) % 60) + " мин";
КонецФункции

Процедура СобратьLinux(Данные)
    ОписаниеОС = ФайлТекст("/etc/os-release");
    Если ОписаниеОС = "" Тогда ОписаниеОС = ФайлТекст("/usr/lib/os-release"); КонецЕсли;
    Данные.Вставить("os_id", БезКавычек(Поле(ОписаниеОС, "ID", "=")));
    Данные.Вставить("os_id_like", БезКавычек(Поле(ОписаниеОС, "ID_LIKE", "=")));
    ОС = Поле(ОписаниеОС, "PRETTY_NAME", "=");
    Если Лев(ОС, 1) = Символ(34) И Прав(ОС, 1) = Символ(34) Тогда
        ОС = Сред(ОС, 2, СтрДлина(ОС) - 2);
    КонецЕсли;
    Если ОС <> "" Тогда Данные.Вставить("os", ОС); КонецЕсли;
    Данные.Вставить("kernel", СокрЛП(ФайлТекст("/proc/sys/kernel/osrelease")));
    ЦП = ФайлТекст("/proc/cpuinfo");
    Модель = Поле(ЦП, "model name");
    Если Модель = "" Тогда Модель = Поле(ЦП, "Hardware"); КонецЕсли;
    Если Модель <> "" Тогда Данные.Вставить("cpu", Модель); КонецЕсли;
    Модель = СокрЛП(ФайлТекст("/sys/devices/virtual/dmi/id/product_name"));
    Если Модель <> "" Тогда Данные.Вставить("host", Модель); КонецЕсли;
    Попытка
        Память = ФайлТекст("/proc/meminfo");
        Всего = ЧислоТекста(СокрЛП(СтрЗаменить(Поле(Память, "MemTotal"), "kB", ""))) * 1024;
        Доступно = Поле(Память, "MemAvailable");
        Если Доступно <> "" Тогда
            Свободно = ЧислоТекста(СокрЛП(СтрЗаменить(Доступно, "kB", ""))) * 1024;
            Данные.Вставить("memory", Гиб(Всего - Свободно) + " / " + Гиб(Всего));
        Иначе
            Данные.Вставить("memory", Гиб(Всего) + " всего");
        КонецЕсли;
    Исключение
        // Недоступные /proc или поля не мешают остальному выводу.
    КонецПопытки;
    Попытка
        Аптайм = СтрРазделить(СокрЛП(ФайлТекст("/proc/uptime")), " ")[0];
        Данные.Вставить("uptime", ВремяРаботы(ЧислоТекста(Аптайм)));
    Исключение
    КонецПопытки;
КонецПроцедуры

Процедура СобратьWindows(Данные)
    // Только локальные запросы WMI; административные права не требуются.
    Попытка
        Локатор = Новый COMОбъект("WbemScripting.SWbemLocator");
        WMI = Локатор.ConnectServer(".", "root\cimv2");
        Для Каждого ОС Из WMI.ExecQuery("SELECT Caption, TotalVisibleMemorySize, FreePhysicalMemory FROM Win32_OperatingSystem") Цикл
            Данные.Вставить("os", СокрЛП(Строка(ОС.Caption)));
            Всего = Число(ОС.TotalVisibleMemorySize) * 1024;
            Свободно = Число(ОС.FreePhysicalMemory) * 1024;
            Данные.Вставить("memory", Гиб(Всего - Свободно) + " / " + Гиб(Всего));
        КонецЦикла;
        Для Каждого ЦП Из WMI.ExecQuery("SELECT Name FROM Win32_Processor") Цикл
            Данные.Вставить("cpu", СокрЛП(Строка(ЦП.Name)));
            Прервать;
        КонецЦикла;
        Для Каждого ПК Из WMI.ExecQuery("SELECT Manufacturer, Model FROM Win32_ComputerSystem") Цикл
            Данные.Вставить("host", СокрЛП(Строка(ПК.Manufacturer)) + " " + СокрЛП(Строка(ПК.Model)));
        КонецЦикла;
        Видеокарты = "";
        Для Каждого GPU Из WMI.ExecQuery("SELECT Name FROM Win32_VideoController") Цикл
            Видеокарты = Видеокарты + ?(Видеокарты = "", "", "; ") + Строка(GPU.Name);
        КонецЦикла;
        Данные.Вставить("gpu", Видеокарты);
    Исключение
        Данные.Вставить("note", "WMI недоступен: показаны базовые сведения");
    КонецПопытки;
КонецПроцедуры

Функция Собрать()
    Данные = Новый Структура;
    Пользователь = Среда("USER");
    Если Пользователь = "" Тогда Пользователь = Среда("USERNAME"); КонецЕсли;
    Если Пользователь = "" Тогда Пользователь = СИ.ПользовательОС; КонецЕсли;
    Данные.Вставить("user", Пользователь);
    Данные.Вставить("hostname", СИ.ИмяКомпьютера);
    Данные.Вставить("host", "");
    Данные.Вставить("os", СИ.ВерсияОС);
    Данные.Вставить("os_id", "");
    Данные.Вставить("os_id_like", "");
    Данные.Вставить("kernel", СИ.ИмяЯдра);
    Данные.Вставить("architecture", ?(СИ.Это64БитнаяОперационнаяСистема, "64 bit", "32 bit"));
    Данные.Вставить("runtime", "OneScript " + СИ.Версия);
    Данные.Вставить("cpu", "");
    Данные.Вставить("threads", СИ.КоличествоПроцессоров);
    Данные.Вставить("gpu", "");
    Данные.Вставить("memory", "");
    Данные.Вставить("uptime", "");
    Данные.Вставить("shell", Среда("SHELL"));
    Данные.Вставить("desktop", Среда("XDG_CURRENT_DESKTOP"));
    Данные.Вставить("session", Среда("XDG_SESSION_TYPE"));
    Данные.Вставить("terminal", Среда("TERM"));
    Данные.Вставить("note", "");
    Попытка
        Данные.Вставить("uptime", ВремяРаботы(СИ.ВремяРаботыСМоментаЗагрузки / 1000));
    Исключение
    КонецПопытки;
    Если Найти(НРег(СИ.ИмяЯдра), "linux") > 0 Тогда
        СобратьLinux(Данные);
    ИначеЕсли Найти(НРег(Строка(СИ.ТипПлатформы)), "win") > 0 Тогда
        Если Данные.shell = "" Тогда Данные.shell = Среда("COMSPEC"); КонецЕсли;
        СобратьWindows(Данные);
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция БезКавычек(Значение)
    Значение = СокрЛП(Значение);
    Если СтрДлина(Значение) >= 2 Тогда
        Первый = Лев(Значение, 1);
        Если (Первый = Символ(34) Или Первый = "'") И Прав(Значение, 1) = Первый Тогда
            Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
        КонецЕсли;
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция КаталогЛоготипов()
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(ФайлТекст(ТекущийСценарий().Каталог + "/assets/logos.json"));
        Результат = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Возврат Результат;
    Исключение
        // При переносе одного .os без каталога assets остаётся логотип 1С.
        Возврат Новый Структура;
    КонецПопытки;
КонецФункции

Функция ИмяЛоготипа(Каталог, Имя)
    Имя = НРег(СокрЛП(Имя));
    Для Каждого Элемент Из Каталог Цикл
        Если НРег(Элемент.Ключ) = Имя Или Элемент.Значение.aliases.Найти(Имя) <> Неопределено Тогда
            Возврат Элемент.Ключ;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция АвтоЛоготип(Каталог, Данные)
    // Точный ID имеет приоритет над названием и семейством дистрибутива.
    Имя = ИмяЛоготипа(Каталог, Данные.os_id);
    Если Имя <> "" Тогда Возврат Имя; КонецЕсли;
    Имя = ИмяЛоготипа(Каталог, Данные.os);
    Если Имя <> "" Тогда Возврат Имя; КонецЕсли;
    Для Каждого Семейство Из СтрРазделить(Данные.os_id_like, " ", Ложь) Цикл
        Имя = ИмяЛоготипа(Каталог, Семейство);
        Если Имя <> "" Тогда Возврат Имя; КонецЕсли;
    КонецЦикла;
    ОС = НРег(Данные.os);
    Ядро = НРег(Данные.kernel);
    Если Найти(ОС, "windows") > 0 Или Найти(Ядро, "windows") > 0 Или Найти(Ядро, "win32") > 0 Тогда
        Если Найти(ОС, "2025") > 0 Тогда Возврат "windows_2025"; КонецЕсли;
        Если Найти(ОС, "windows 11") > 0 Или Найти(ОС, "2022") > 0 Тогда Возврат "windows_11"; КонецЕсли;
        Если Найти(ОС, "windows 10") > 0 Или Найти(ОС, "windows 8") > 0
            Или Найти(ОС, "2012") > 0 Или Найти(ОС, "2016") > 0 Или Найти(ОС, "2019") > 0 Тогда
            Возврат "windows_8";
        КонецЕсли;
        Возврат "windows";
    КонецЕсли;
    Если Найти(Ядро, "darwin") > 0 Или Найти(ОС, "macos") > 0 Тогда Возврат "macos"; КонецЕсли;
    Для Каждого Семейство Из СтрРазделить("freebsd openbsd netbsd dragonfly", " ") Цикл
        Если Найти(Ядро, Семейство) > 0 Или Найти(ОС, Семейство) > 0 Тогда Возврат Семейство; КонецЕсли;
    КонецЦикла;
    Если Найти(Ядро, "linux") > 0 Тогда Возврат "linux"; КонецЕсли;
    Возврат "unknown";
КонецФункции

Функция Логотип1С()
    Линии = СтрРазделить("                          
        |    111      CCCCCCCCC
        |  11111    CCC      CCC
        |    111   CCC
        |    111   CCC
        |    111   CCC
        |    111   CCC
        |    111    CCC      CCC
        |  1111111    CCCCCCCCC
        |
        |        onec-fetch", Символы.ПС);
    Палитра = Новый Массив;
    Палитра.Добавить("31");
    Возврат Новый Структура("lines,colors", Линии, Палитра);
КонецФункции

Функция Логотип(Каталог, Данные, Выбор)
    Если Выбор = "1c" Тогда Возврат Логотип1С(); КонецЕсли;
    Если Выбор = "auto" Тогда Выбор = АвтоЛоготип(Каталог, Данные); КонецЕсли;
    Имя = ИмяЛоготипа(Каталог, Выбор);
    Если Имя = "" Тогда Возврат Логотип1С(); КонецЕсли;
    Результат = Неопределено;
    Каталог.Свойство(Имя, Результат);
    Возврат Результат;
КонецФункции

Функция БезМаркеров(Линия)
    Для Номер = 1 По 9 Цикл
        Линия = СтрЗаменить(Линия, "$" + ЦелоеТекст(Номер), "");
    КонецЦикла;
    Возврат Линия;
КонецФункции

Функция РаскраситьЛоготип(Линия, Палитра, ТекущийЦвет)
    Результат = "";
    Если Цвет Тогда Результат = Символ(27) + "[1;" + ТекущийЦвет + "m"; КонецЕсли;
    Индекс = 1;
    Пока Индекс <= СтрДлина(Линия) Цикл
        Знак = Сред(Линия, Индекс, 1);
        Номер = 0;
        Если Знак = "$" И Индекс < СтрДлина(Линия) Тогда
            Номер = Найти("123456789", Сред(Линия, Индекс + 1, 1));
        КонецЕсли;
        Если Номер > 0 Тогда
            Если Палитра.Количество() > 0 Тогда
                ТекущийЦвет = Палитра[Мин(Номер - 1, Палитра.Количество() - 1)];
            КонецЕсли;
            Если Цвет Тогда Результат = Результат + Символ(27) + "[1;" + ТекущийЦвет + "m"; КонецЕсли;
            Индекс = Индекс + 2;
        Иначе
            Результат = Результат + Знак;
            Индекс = Индекс + 1;
        КонецЕсли;
    КонецЦикла;
    Если Цвет Тогда Результат = Результат + Символ(27) + "[0m"; КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Окрасить(Текст, Код)
    Возврат ?(Цвет, Символ(27) + "[" + Код + "m" + Текст + Символ(27) + "[0m", Текст);
КонецФункции

Процедура Добавить(Строки, Название, Значение)
    Если Строка(Значение) <> "" Тогда
        Строки.Добавить(Окрасить(Название + ": ", "1;33") + Строка(Значение));
    КонецЕсли;
КонецПроцедуры

Процедура Вывести(Данные, БезЛоготипа, Рисунок)
    Строки = Новый Массив;
    Строки.Добавить(Окрасить(Данные.user + "@" + Данные.hostname, "1;31"));
    Строки.Добавить("-----------------------------");
    Добавить(Строки, "ОС", Данные.os);
    Добавить(Строки, "Компьютер", Данные.host);
    Добавить(Строки, "Ядро", Данные.kernel);
    Добавить(Строки, "Архитектура ОС", Данные.architecture);
    Добавить(Строки, "Работает", Данные.uptime);
    Добавить(Строки, "Оболочка", Данные.shell);
    Добавить(Строки, "Среда", Данные.desktop);
    Добавить(Строки, "Сеанс", Данные.session);
    Добавить(Строки, "Терминал", Данные.terminal);
    Добавить(Строки, "Процессор", Данные.cpu);
    Добавить(Строки, "Логические CPU среды", Данные.threads);
    Добавить(Строки, "Видеокарта", Данные.gpu);
    Добавить(Строки, "Память", Данные.memory);
    Добавить(Строки, "Исполнитель", Данные.runtime);
    Добавить(Строки, "Примечание", Данные.note);
    Если Цвет Тогда
        Палитра = "";
        Для Номер = 40 По 47 Цикл
            Палитра = Палитра + Окрасить("   ", ЦелоеТекст(Номер));
        КонецЦикла;
        Строки.Добавить(Палитра);
    КонецЕсли;
    Лого = Рисунок.lines;
    Ширина = 0;
    Если Не БезЛоготипа Тогда
        Для Каждого Линия Из Лого Цикл
            Ширина = Макс(Ширина, СтрДлина(БезМаркеров(Линия)));
        КонецЦикла;
    КонецЕсли;
    ТекущийЦвет = "37";
    Если Рисунок.colors.Количество() > 0 Тогда ТекущийЦвет = Рисунок.colors[0]; КонецЕсли;
    Сообщить("");
    КоличествоСтрок = Строки.Количество();
    Если Не БезЛоготипа Тогда КоличествоСтрок = Макс(КоличествоСтрок, Лого.Количество()); КонецЕсли;
    Для Индекс = 0 По КоличествоСтрок - 1 Цикл
        Слева = "";
        Если Не БезЛоготипа Тогда
            Линия = "";
            Если Индекс < Лого.Количество() Тогда Линия = Лого[Индекс]; КонецЕсли;
            Отступ = "";
            Для Номер = СтрДлина(БезМаркеров(Линия)) + 1 По Ширина Цикл
                Отступ = Отступ + " ";
            КонецЦикла;
            Слева = РаскраситьЛоготип(Линия, Рисунок.colors, ТекущийЦвет) + Отступ + "  ";
        КонецЕсли;
        Справа = "";
        Если Индекс < Строки.Количество() Тогда Справа = Строки[Индекс]; КонецЕсли;
        Сообщить(Слева + Справа);
    КонецЦикла;
    Сообщить("");
КонецПроцедуры

СИ = Новый СистемнаяИнформация;
Цвет = Среда("TERM") <> "" И Среда("TERM") <> "dumb" И ПеременныеСреды().Получить("NO_COLOR") = Неопределено;
БезЛоготипа = Ложь;
JSON = Ложь;
ВыборЛоготипа = "auto";
Каталог = КаталогЛоготипов();
Для Каждого Аргумент Из АргументыКоманднойСтроки Цикл
    Если Аргумент = "--help" Или Аргумент = "-h" Тогда
        Сообщить("onec-fetch — аналог fastfetch на языке 1С / OneScript");
        Сообщить("Запуск: oscript onec-fetch.os [--no-color|--color] [--no-logo] [--logo=ИМЯ] [--json]");
        Сообщить("--json: машинный вывод; --version: версия; --help: справка.");
        Сообщить("--logo=auto: по системе; --logo=1c: логотип 1С; --list-logos: список.");
        ЗавершитьРаботу(0);
    ИначеЕсли Аргумент = "--version" Тогда
        Сообщить("onec-fetch 1.1.0");
        ЗавершитьРаботу(0);
    ИначеЕсли Аргумент = "--list-logos" Тогда
        Сообщить("auto");
        Сообщить("1c");
        Для Каждого Элемент Из Каталог Цикл Сообщить(Элемент.Ключ); КонецЦикла;
        ЗавершитьРаботу(0);
    ИначеЕсли Лев(Аргумент, 7) = "--logo=" Тогда
        ВыборЛоготипа = НРег(Сред(Аргумент, 8));
        Если ВыборЛоготипа <> "auto" И ВыборЛоготипа <> "1c" Тогда
            Если ИмяЛоготипа(Каталог, ВыборЛоготипа) = "" Тогда
                Сообщить("Неизвестный логотип: " + ВыборЛоготипа + ". Используйте --list-logos.");
                ЗавершитьРаботу(2);
            КонецЕсли;
        КонецЕсли;
    ИначеЕсли Аргумент = "--no-color" Тогда
        Цвет = Ложь;
    ИначеЕсли Аргумент = "--color" Тогда
        Цвет = Истина;
    ИначеЕсли Аргумент = "--no-logo" Тогда
        БезЛоготипа = Истина;
    ИначеЕсли Аргумент = "--json" Тогда
        JSON = Истина;
    Иначе
        Сообщить("Неизвестный аргумент: " + Аргумент + ". Используйте --help.");
        ЗавершитьРаботу(2);
    КонецЕсли;
КонецЦикла;
Данные = Собрать();
Если JSON Тогда
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Сообщить(Запись.Закрыть());
Иначе
    Вывести(Данные, БезЛоготипа, Логотип(Каталог, Данные, ВыборЛоготипа));
КонецЕсли;
