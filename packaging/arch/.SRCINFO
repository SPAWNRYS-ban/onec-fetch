pkgbase = onec-fetch
	pkgdesc = System information tool written in 1C / OneScript
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/SPAWNRYS-ban/onec-fetch
	arch = x86_64
	license = MIT
	license = MPL-2.0
	depends = glibc
	depends = libgcc
