	depends = openssl
	depends = zlib
	depends = ca-certificates
	depends = tzdata
	depends = coreutils
	depends = procps-ng
	depends = pciutils
	depends = iproute2
	optdepends = qt6-tools: KDE display and MPRIS metadata
	optdepends = kscreen: KDE display modes
	optdepends = mesa-utils: OpenGL details
	optdepends = vulkan-tools: Vulkan details
	optdepends = clinfo: OpenCL details
	optdepends = nvidia-utils: NVIDIA memory and temperature
	optdepends = networkmanager: connected Wi-Fi details
	optdepends = libpulse: sound volume and devices
	optdepends = bluez-utils: Bluetooth details
	optdepends = playerctl: fallback media details
	optdepends = dmidecode: physical memory details
	optdepends = ddcutil: external display brightness
	optdepends = tpm2-tools: detailed TPM properties
	optdepends = btrfs-progs: Btrfs volume details
